{
  "name": "blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 4322",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "proto:dev": "astro dev --config prototypes/astro.config.mjs",
    "proto:build": "astro build --config prototypes/astro.config.mjs",
    "judges": "node scripts/judges.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "proto:serve": "node scripts/serve.mjs prototypes/dist 4331",
    "proto:judge": "node prototypes/scripts/judge.mjs http://localhost:4331",
    "proto:gallery": "node prototypes/scripts/shoot.mjs http://localhost:4331 prototypes/.shots && node prototypes/scripts/gallery.mjs prototypes/.shots",
    "registry:check": "node scripts/check-registry.ts",
    "post:new": "node scripts/post.ts new",
    "post:publish": "node scripts/post.ts publish",
    "post:touch": "node scripts/post.ts touch"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "fast-xml-parser": "5.11.2",
    "gpt-tokenizer": "4.1.0",
    "html-validate": "11.17.0",
    "lighthouse": "13.6.0",
    "linkinator": "8.1.0",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
