---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  author: string;
  date: Date;
  readingTime: number;
  description?: string;
}

const { title, author, date, readingTime, description } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <div style="color: var(--fg-secondary); font-size: 14px; margin: 1rem 0;">
        <p>{author} • {formattedDate} • {readingTime} min read</p>
      </div>
    </header>
    <slot />
    <footer style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); color: var(--fg-secondary); font-size: 14px;">
      <p><strong>About the author:</strong> Daniel Baumann is a software engineer focused on AI, systems architecture, and developer tooling.</p>
      <p><a href="/">← Back to all posts</a></p>
    </footer>
  </article>
</BaseLayout>
