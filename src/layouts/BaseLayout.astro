---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description || "A blog about AI, agents, and tooling"} />
    <title>{title} | dr4w blog</title>
    <style>
      :root {
        --bg-dark: #0A0A0F;
        --bg-light: #FFFFFF;
        --fg-primary: #FFFFFF;
        --fg-secondary: #A0A0A0;
        --accent: #0066FF;
        --border: #2A2A3F;
      }

      body {
        background: var(--bg-dark);
        color: var(--fg-primary);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 18px;
        line-height: 1.6;
        margin: 0;
        padding: 0;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      header {
        border-bottom: 1px solid var(--border);
        padding: 2rem;
        text-align: center;
      }

      main {
        max-width: 700px;
        margin: 0 auto;
        padding: 2rem;
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 2rem;
        text-align: center;
        color: var(--fg-secondary);
        font-size: 14px;
      }

      h1, h2, h3 {
        margin-top: 1.5em;
        margin-bottom: 0.5em;
      }

      h1 {
        font-size: 2.5rem;
      }

      h2 {
        font-size: 2rem;
      }

      h3 {
        font-size: 1.5rem;
      }

      code {
        background: #1A1A2F;
        padding: 0.2em 0.4em;
        border-radius: 3px;
        font-family: "Monaco", "Menlo", monospace;
        font-size: 0.9em;
      }

      pre {
        background: #1A1A2F;
        padding: 1rem;
        border-radius: 5px;
        overflow-x: auto;
      }

      pre code {
        background: none;
        padding: 0;
      }

      blockquote {
        border-left: 4px solid var(--accent);
        margin: 1rem 0;
        padding-left: 1rem;
        color: var(--fg-secondary);
      }
    </style>
  </head>
  <body>
    <header>
      <h1><a href="/">dr4w</a></h1>
      <p>AI, agents, and tooling</p>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2026 Daniel Baumann. All rights reserved.</p>
    </footer>
  </body>
</html>
