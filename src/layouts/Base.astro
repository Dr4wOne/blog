---
// Every page: head (SEO, sharing, fonts, styles), skip link, site header and footer.
import { Font } from 'astro:assets'
import '../styles/base.css'
import '../styles/figures.css'
import '../styles/theme.css'
import { SITE } from '../site.ts'

interface Props {
  title: string // page title without the site name; '' for the home page
  description: string
  type?: 'website' | 'article'
  ogImage?: string // path under the site, e.g. /og/01-slug.png
  jsonLd?: Record<string, unknown>
  islands?: boolean // article pages load widget code lazily
  kind?: 'home' | 'article' | 'page'
  published?: Date
  modified?: Date
  noindex?: boolean
}
const {
  title,
  description,
  type = 'website',
  ogImage = '/og/default.png',
  jsonLd,
  islands = false,
  kind = 'page',
  published,
  modified,
  noindex = false,
} = Astro.props
const full = title ? `${title} · ${SITE.name}` : SITE.title
const canonical = new URL(Astro.url.pathname, SITE.url).href
const image = new URL(ogImage, SITE.url).href
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={SITE.author.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title={SITE.title} href="/feed.json" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <Font cssVariable="--font-source-serif" preload={[{ style: 'normal' }]} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-page={kind}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/">dr4w</a>
      <nav aria-label="Site">
        <a href="/#issues">Issues</a>
        <a href="/about/">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Written by <a href={SITE.author.url}>{SITE.author.name}</a> · <a href="/rss.xml">RSS</a> · <a href="/feed.json">JSON Feed</a>
      </p>
    </footer>
    {islands && <script>import '../scripts/islands.ts'</script>}
  </body>
</html>
