---
import SignalTransmission from '../layouts/SignalTransmission.astro';

const title = "AI From the Ground Up: LLMs, Agents, Harnesses and the Tooling Around Them";
const subtitle = "A guided tour, with no math, from what an LLM actually is to the agents and tooling people use to get real work done with it.";
const author = "Daniel Baumann";
const date = new Date('2026-10-15');
const readingTime = 20;
---

<SignalTransmission 
  title={title}
  subtitle={subtitle}
  author={author}
  date={date}
  readingTime={readingTime}
/>
