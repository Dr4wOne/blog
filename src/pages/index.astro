---
import '../styles/global.css';

const title = "Blog — dr4w.io"
const description = "Writing on software engineering, AI, and technology"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Space+Grotesk:wght@600&family=JetBrains+Mono&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-bg text-text font-body">
    <header class="border-b border-text-dim p-6">
      <nav class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-display font-bold text-primary">blog.dr4w.io</h1>
        <p class="text-text-muted mt-2">Writing on software, AI, and technology</p>
      </nav>
    </header>

    <main class="max-w-4xl mx-auto p-6">
      <section>
        <h2 class="text-2xl font-display font-bold mb-6">Latest Posts</h2>
        <p class="text-text-muted">No posts yet. Coming soon...</p>
      </section>
    </main>

    <footer class="border-t border-text-dim mt-12 p-6 text-center text-text-muted">
      <p>&copy; 2026 Daniel Baumann. All writing is available on this blog.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #0A0A0F;
    --color-bg-surface: #111118;
    --color-primary: #6C63FF;
    --color-accent: #00D9FF;
    --color-text: #F0F0FF;
    --color-text-muted: #8888AA;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
  }

  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  code {
    font-family: 'JetBrains Mono', monospace;
    background-color: var(--color-bg-surface);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  pre {
    background-color: var(--color-bg-surface);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  pre code {
    background-color: transparent;
    padding: 0;
  }
</style>
