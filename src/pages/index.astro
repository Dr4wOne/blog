---
import Base from '../layouts/Base.astro'
import { dateFormat, readingMinutes } from '../lib/article.ts'
import { publishedPosts } from '../lib/posts.ts'
import { SITE } from '../site.ts'

const posts = await publishedPosts()
const [latest] = posts
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.title,
  url: `${SITE.url}/`,
  description: SITE.description,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.author.url,
    jobTitle: SITE.author.jobTitle,
  },
}
---

<Base title="" description={SITE.description} kind="home" jsonLd={jsonLd}>
  <div class="home">
    <section class="intro" aria-labelledby="intro-h">
      <h1 id="intro-h">Notes from Daniel</h1>
      <p>
        I’m Daniel Baumann, a software engineer. This is where I write things down properly: how things work, what I’m
        building, what I’m learning, and whatever else is worth the time to think through.
      </p>
    </section>
    {
      latest && (
        <article class="latest" aria-labelledby="latest-h">
          <h2 class="latest-title" id="latest-h">
            <a href={latest.path}>{latest.data.title}</a>
          </h2>
          <p class="issue-line">
            Latest: Issue {latest.issue} · <time datetime={latest.published.toISOString().slice(0, 10)}>{dateFormat.format(latest.published)}</time> ·{' '}
            {readingMinutes(latest.body ?? '')} min read
          </p>
          <p class="latest-summary">{latest.data.summary}</p>
          <a class="read" href={latest.path}>
            Read issue {latest.issue}
          </a>
        </article>
      )
    }
    <section id="issues" class="index" aria-labelledby="issues-h">
      <h2 id="issues-h">All issues</h2>
      <ol>
        {
          posts.map((p) => (
            <li>
              <span class="n">No. {p.issue}</span>
              <a href={p.path}>{p.data.title}</a>
              <time class="when" datetime={p.published.toISOString().slice(0, 10)}>
                {dateFormat.format(p.published)}
              </time>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>
