---
import { MISSION_LOG } from '../constants/labels';

interface Props {
  parts: { number: number; title: string; id: string }[];
}

const { parts } = Astro.props;
---

<nav class="mission-log-sticky">
  <div class="mission-log-header">
    <div class="hud-label">{MISSION_LOG.title}</div>
  </div>
  <ol class="mission-log-list">
    {parts.map((part) => (
      <li>
        <a href={`#${part.id}`} class="log-entry">
          <span class="log-number">LOG {String(part.number).padStart(2, '0')}</span>
          <span class="log-title">{part.title}</span>
        </a>
      </li>
    ))}
  </ol>
  <div class="progress-bar">
    <div class="progress-fill"></div>
  </div>
</nav>

<style>
  .mission-log-sticky {
    position: sticky;
    top: 0;
    display: none;
    flex-direction: column;
    width: 200px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 2px;
    padding: 1rem;
    gap: 1rem;
    max-height: 100vh;
    overflow-y: auto;
    font-size: 12px;
  }
  
  .mission-log-header {
    border-bottom: 1px dashed var(--signal);
    padding-bottom: 0.5rem;
  }
  
  .hud-label {
    font-size: 10px;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  
  .mission-log-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .log-entry {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem;
    border-radius: 2px;
    color: var(--text-dim);
    text-decoration: none;
    transition: all 0.2s;
    border: 1px solid transparent;
  }
  
  .log-entry:hover {
    background: var(--steel-900);
    color: var(--signal);
    border-color: var(--signal);
  }
  
  .log-number {
    font-family: var(--font-display);
    color: var(--red);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .log-title {
    font-size: 11px;
    line-height: 1.3;
  }
  
  .progress-bar {
    height: 3px;
    background: var(--steel-900);
    border-radius: 1px;
    overflow: hidden;
    margin-top: auto;
  }
  
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--signal), var(--red));
    width: 0%;
    transition: width 0.2s;
  }
  
  /* Show on desktop (1024px+) */
  @media (min-width: 1024px) {
    .mission-log-sticky {
      display: flex;
    }
  }
  
  /* Mobile: horizontal collapse */
  @media (max-width: 768px) {
    .mission-log-sticky {
      display: none;
    }
    
    .mission-log-mobile {
      position: sticky;
      top: 0;
      background: var(--panel);
      border-bottom: 1px solid var(--panel-border);
      padding: 0.75rem;
      z-index: 100;
      overflow-x: auto;
    }
    
    .mission-log-list {
      flex-direction: row;
      gap: 0.5rem;
      white-space: nowrap;
    }
  }
</style>
