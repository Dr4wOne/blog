---
/* Fading background images with animations - similar to landpage */
---

<!-- Multiple fading image layers -->
<div class="fading-images">
  <!-- Layer 1: Character sheet (top-left, slower) -->
  <div class="fade-layer fade-slow" style="--delay: 0s">
    <img
      src="/assets/sheet-dr4w-iron-hunt.webp"
      alt=""
      role="presentation"
    />
  </div>

  <!-- Layer 2: Aura effect (bottom-right, medium) -->
  <div class="fade-layer fade-medium" style="--delay: 2s">
    <img
      src="/assets/sprite-aura-blue-gold-light.webp"
      alt=""
      role="presentation"
    />
  </div>

  <!-- Layer 3: Character silhouette (top-center, fast) -->
  <div class="fade-layer fade-fast" style="--delay: 4s">
    <img
      src="/assets/sprite-aura-dark-glow.webp"
      alt=""
      role="presentation"
    />
  </div>
</div>

<style>
  .fading-images {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .fade-layer {
    position: absolute;
    width: 400px;
    height: 400px;
    opacity: 0;
    filter: blur(30px);
    mix-blend-mode: screen;
  }

  .fade-layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  /* Position variants */
  .fade-layer:nth-child(1) {
    top: 10%;
    left: -10%;
    width: 500px;
    height: 500px;
    animation: fade-in-out 8s ease-in-out infinite var(--delay);
  }

  .fade-layer:nth-child(2) {
    bottom: -5%;
    right: -5%;
    width: 600px;
    height: 600px;
    animation: fade-in-out 10s ease-in-out infinite var(--delay);
  }

  .fade-layer:nth-child(3) {
    top: 20%;
    right: 5%;
    width: 450px;
    height: 450px;
    animation: fade-in-out 12s ease-in-out infinite var(--delay);
  }

  /* Animation speeds */
  .fade-slow {
    animation-duration: 14s !important;
  }

  .fade-medium {
    animation-duration: 10s !important;
  }

  .fade-fast {
    animation-duration: 8s !important;
  }

  /* Fade animation */
  @keyframes fade-in-out {
    0%, 100% {
      opacity: 0;
    }
    25% {
      opacity: 0.08;
    }
    50% {
      opacity: 0.04;
    }
    75% {
      opacity: 0.08;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-layer {
      animation: none !important;
      opacity: 0.02;
    }
  }
</style>
