---
import { INTERACTIVE_WIDGETS } from '../constants/labels';
---

<div class="widget tokenizer-widget">
  <div class="widget-header">
    <h4>{INTERACTIVE_WIDGETS.tokenizerTitle}</h4>
    <p class="widget-hint">{INTERACTIVE_WIDGETS.tokenizerHint}</p>
  </div>
  <textarea
    id="tokenizer-input"
    placeholder={INTERACTIVE_WIDGETS.tokenizerPlaceholder}
    rows="3"
  ></textarea>
  <div class="tokenizer-output">
    <div id="tokenizer-bricks" class="brick-row"></div>
    <div class="tokenizer-stats">
      <span id="tokenizer-count">0 tokens</span>
    </div>
  </div>
  <p class="widget-note">{INTERACTIVE_WIDGETS.tokenizerNote}</p>
</div>

<div class="widget temperature-widget">
  <div class="widget-header">
    <h4>{INTERACTIVE_WIDGETS.temperatureTitle}</h4>
    <p class="widget-hint">{INTERACTIVE_WIDGETS.temperatureHint}</p>
  </div>
  <div class="temperature-control">
    <label for="temp-slider">{INTERACTIVE_WIDGETS.temperatureLabel}</label>
    <input type="range" id="temp-slider" min="0" max="2" step="0.1" value="1">
    <span id="temp-value">1.0</span>
  </div>
  <div class="temperature-outputs">
    <div class="sample-output">
      <p class="sample-label">{INTERACTIVE_WIDGETS.temperatureSample1}</p>
      <p id="sample-1" class="sample-text">The next word is likely to be…</p>
    </div>
    <div class="sample-output">
      <p class="sample-label">{INTERACTIVE_WIDGETS.temperatureSample2}</p>
      <p id="sample-2" class="sample-text">The next word might be…</p>
    </div>
  </div>
</div>

<div class="widget agent-widget">
  <div class="widget-header">
    <h4>{INTERACTIVE_WIDGETS.agentTitle}</h4>
    <p class="widget-hint">{INTERACTIVE_WIDGETS.agentHint}</p>
  </div>
  <div class="agent-loop">
    <div class="loop-display">
      <div id="agent-step" class="step-current">
        <strong>{INTERACTIVE_WIDGETS.agentGoal}:</strong>
        <p>{INTERACTIVE_WIDGETS.agentExampleGoal}</p>
      </div>
    </div>
    <button id="agent-next-btn" class="agent-button">{INTERACTIVE_WIDGETS.agentNextBtn}</button>
    <button id="agent-reset-btn" class="agent-button agent-secondary">{INTERACTIVE_WIDGETS.agentResetBtn}</button>
    <div id="agent-approval" class="approval-gate" style="display: none;">
      <p><strong>{INTERACTIVE_WIDGETS.agentApprovalRequired}</strong></p>
      <p>Run: <code>npm test</code></p>
      <button id="agent-approve-btn" class="agent-approve">{INTERACTIVE_WIDGETS.agentApproveBtn}</button>
      <button id="agent-deny-btn" class="agent-deny">{INTERACTIVE_WIDGETS.agentDenyBtn}</button>
    </div>
  </div>
</div>

<script define:vars={{
  agentGoal: INTERACTIVE_WIDGETS.agentGoal,
  agentExampleGoal: INTERACTIVE_WIDGETS.agentExampleGoal,
  agentReason: INTERACTIVE_WIDGETS.agentReason,
  agentReasonExample: INTERACTIVE_WIDGETS.agentReasonExample,
  agentAct: INTERACTIVE_WIDGETS.agentAct,
  agentActExample: INTERACTIVE_WIDGETS.agentActExample,
  agentObserve: INTERACTIVE_WIDGETS.agentObserve,
  agentObserveExample: INTERACTIVE_WIDGETS.agentObserveExample,
  agentGoalMet: INTERACTIVE_WIDGETS.agentGoalMet,
  agentGoalMetExample: INTERACTIVE_WIDGETS.agentGoalMetExample,
  temperatureLikelyPrefix: INTERACTIVE_WIDGETS.temperatureLikelyPrefix,
  temperaturePossiblyPrefix: INTERACTIVE_WIDGETS.temperaturePossiblyPrefix,
  agentDeniedMsg: INTERACTIVE_WIDGETS.agentDeniedMsg,
}}>
  // Tokenizer widget
  const tokenizerInput = document.getElementById('tokenizer-input');
  const tokenizerBricks = document.getElementById('tokenizer-bricks');
  const tokenizerCount = document.getElementById('tokenizer-count');
  
  // Simple mock tokenizer
  function mockTokenize(text) {
    // Very rough approximation: ~0.75 words per token
    const words = text.trim().split(/\s+/);
    return Math.ceil(words.length * 1.33);
  }
  
  tokenizerInput?.addEventListener('input', () => {
    const text = tokenizerInput.value;
    const tokens = Math.max(0, mockTokenize(text));
    tokenizerCount.textContent = `${tokens} token${tokens !== 1 ? 's' : ''}`;
    
    // Show some bricks (simple visual)
    const words = text.split(/\s+/).filter(w => w.length > 0).slice(0, 10);
    tokenizerBricks.innerHTML = words.map((w, i) => 
      `<div class="brick" title="word ${i + 1}">${w.substring(0, 8)}</div>`
    ).join('');
  });
  
  // Temperature slider
  const tempSlider = document.getElementById('temp-slider');
  const tempValue = document.getElementById('temp-value');
  const samples = [
    ['the', 'a', 'your'],
    ['probably', 'might', 'could'],
    ['important', 'useful', 'necessary']
  ];
  
  function updateTemperature() {
    const temp = parseFloat(tempSlider.value).toFixed(1);
    tempValue.textContent = temp;

    const index = temp < 0.7 ? 0 : temp > 1.3 ? 2 : 1;
    document.getElementById('sample-1').textContent = `${temperatureLikelyPrefix} "${samples[index][0]}"`;
    document.getElementById('sample-2').textContent = `${temperaturePossiblyPrefix} "${samples[index][1]}"`;
  }
  
  tempSlider?.addEventListener('input', updateTemperature);
  updateTemperature();
  
  const agentSteps = [
    { phase: agentGoal, text: agentExampleGoal, action: false },
    { phase: agentReason, text: agentReasonExample, action: false },
    { phase: agentAct, text: agentActExample, action: true },
    { phase: agentObserve, text: agentObserveExample, action: false },
    { phase: agentGoalMet, text: agentGoalMetExample, action: false }
  ];
  
  let currentStep = 0;
  const agentStepDisplay = document.getElementById('agent-step');
  const agentNextBtn = document.getElementById('agent-next-btn');
  const agentResetBtn = document.getElementById('agent-reset-btn');
  const agentApproval = document.getElementById('agent-approval');
  
  function displayStep() {
    const step = agentSteps[currentStep];
    agentStepDisplay.innerHTML = `<strong>${step.phase}:</strong><p>${step.text}</p>`;
    
    if (step.action) {
      agentApproval.style.display = 'block';
    } else {
      agentApproval.style.display = 'none';
    }
    
    agentNextBtn.disabled = currentStep >= agentSteps.length - 1;
  }
  
  agentNextBtn?.addEventListener('click', () => {
    if (currentStep < agentSteps.length - 1) {
      currentStep++;
      displayStep();
    }
  });
  
  agentResetBtn?.addEventListener('click', () => {
    currentStep = 0;
    displayStep();
  });
  
  document.getElementById('agent-approve-btn')?.addEventListener('click', () => {
    currentStep++;
    displayStep();
  });
  
  document.getElementById('agent-deny-btn')?.addEventListener('click', () => {
    agentApproval.style.display = 'none';
    alert(agentDeniedMsg);
  });
  
  displayStep();
</script>

<style>
  .widget {
    margin: 2rem 0;
    padding: 1.5rem;
    background: rgba(26, 26, 38, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .widget:hover {
    border-color: rgba(108, 99, 255, 0.2);
    background: rgba(26, 26, 38, 0.8);
  }

  .widget-header {
    margin-bottom: 1rem;
  }

  .widget-header h4 {
    margin: 0 0 0.25rem;
    color: var(--primary);
    font-size: 1.1rem;
    font-family: var(--font-display);
  }

  .widget-hint {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  
  /* Tokenizer */
  #tokenizer-input {
    width: 100%;
    padding: 0.75rem;
    background: var(--bg-surface);
    color: var(--text);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    font-family: var(--font-code);
    font-size: 0.95rem;
    resize: vertical;
    transition: border-color 0.2s ease;
  }

  #tokenizer-input:focus {
    outline: none;
    border-color: rgba(108, 99, 255, 0.3);
    background: rgba(26, 26, 38, 0.4);
  }

  .tokenizer-output {
    margin-top: 1rem;
  }

  .brick-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .brick {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    background: var(--primary);
    color: var(--bg);
    border-radius: 6px;
    font-size: 0.85rem;
    font-family: var(--font-code);
    font-weight: 500;
  }

  .tokenizer-stats {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  
  /* Temperature */
  .temperature-control {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  #temp-slider {
    flex: 1;
    cursor: pointer;
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(to right, var(--primary), var(--accent));
    outline: none;
    -webkit-appearance: none;
    appearance: none;
  }

  #temp-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--primary);
    cursor: pointer;
    box-shadow: 0 0 10px rgba(108, 99, 255, 0.5);
  }

  #temp-slider::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--primary);
    cursor: pointer;
    border: none;
    box-shadow: 0 0 10px rgba(108, 99, 255, 0.5);
  }

  #temp-value {
    min-width: 50px;
    text-align: center;
    font-weight: bold;
    color: var(--primary);
    font-family: var(--font-code);
  }

  .temperature-outputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .sample-output {
    padding: 0.75rem;
    background: var(--bg-surface);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
  }

  .sample-label {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: bold;
    font-family: var(--font-code);
  }

  .sample-text {
    margin: 0;
    font-style: italic;
    color: var(--text);
    font-size: 0.95rem;
  }
  
  /* Agent stepper */
  .agent-loop {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .loop-display {
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid rgba(0, 217, 255, 0.3);
    border-radius: 8px;
    min-height: 100px;
    display: flex;
    align-items: center;
  }

  .step-current {
    width: 100%;
  }

  .step-current strong {
    display: block;
    color: var(--accent);
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
    text-transform: uppercase;
    font-family: var(--font-code);
  }

  .step-current p {
    margin: 0;
    color: var(--text);
    line-height: 1.4;
  }

  .agent-button {
    padding: 0.75rem 1.5rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-code);
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .agent-button:hover:not(:disabled) {
    background: var(--primary-soft);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(108, 99, 255, 0.3);
  }

  .agent-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .agent-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text);
  }

  .agent-secondary:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.15);
  }

  .approval-gate {
    padding: 1.25rem;
    background: rgba(255, 107, 53, 0.05);
    border: 1px solid rgba(255, 107, 53, 0.3);
    border-radius: 8px;
  }

  .approval-gate p {
    margin: 0 0 0.75rem;
    color: var(--text);
  }

  .approval-gate code {
    background: var(--bg-surface);
    color: var(--warm);
    padding: 0.2em 0.4em;
    border-radius: 4px;
  }

  .agent-approve {
    background: var(--accent);
    color: var(--bg);
    padding: 0.5rem 1rem;
    margin-right: 0.5rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .agent-approve:hover {
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .agent-deny {
    background: var(--warm);
    color: white;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .agent-deny:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .widget-note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-style: italic;
  }
  
  @media (max-width: 768px) {
    .widget {
      padding: 1.25rem;
    }

    .temperature-outputs {
      grid-template-columns: 1fr;
    }

    .agent-button,
    .agent-approve,
    .agent-deny {
      width: 100%;
    }

    .agent-approve {
      margin-right: 0;
      margin-bottom: 0.5rem;
    }

    .temperature-control {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
