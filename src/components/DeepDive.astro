---
// A closed-by-default deep dive that stays in the text column (unlike Aside, which floats into the
// narrow margin), for optional detail with code. Native <details>: keyboard and screen-reader ready.
interface Props {
  title: string
}
const { title } = Astro.props
---

<details class="deep-dive">
  <summary>{title}</summary>
  <div class="deep-dive-body"><slot /></div>
</details>

<style>
  .deep-dive {
    margin: 2rem 0;
    background: var(--surface);
    border-radius: var(--radius);
    font-size: 1rem;
    line-height: 1.55;
  }
  summary {
    padding: 0.9rem 1.25rem;
    font-weight: 600;
    cursor: pointer;
  }
  .deep-dive-body {
    padding: 0 0.75rem 0.75rem;
  }
  .deep-dive-body > :global(p) {
    margin: 0 0.5rem 1rem;
  }
  /* Narrower type and padding so a 70-character line fits the 35rem column without scrolling. */
  .deep-dive-body :global(pre) {
    margin: 0;
    padding: 0.75rem;
    font-size: 0.75rem;
    background: var(--surface-2) !important;
  }
</style>
