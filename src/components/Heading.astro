---
// MDX heading override: keeps the id and adds a self-link for sharing a section.
interface Props {
  id?: string
  level: 2 | 3
}
const { id, level } = Astro.props
const Tag = `h${level}` as 'h2' | 'h3'
---

<Tag id={id} class="heading">
  <slot />{id && <a class="anchor" href={`#${id}`} aria-label="Link to this section">#</a>}
</Tag>
