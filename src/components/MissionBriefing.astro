---
import { MISSION_BRIEFING } from '../constants/labels';
---

<section class="mission-briefing">
  <div class="briefing-header">
    <h2>{MISSION_BRIEFING.title}</h2>
    <p>{MISSION_BRIEFING.yearAndSetup}<em>{MISSION_BRIEFING.distressSignal}</em></p>
  </div>

  <div class="comic-strip-scroll">
    <img
      src="/assets/comic-p01-intro.webp"
      alt="Comic: Year 2194, Iron Hunt protocol, DR4W unit inactive, distress signal, awakening sequence"
      data-pixelated
      loading="lazy"
    />
  </div>

  <div class="briefing-promise">
    <p><strong>{MISSION_BRIEFING.noMathRequired}</strong> {MISSION_BRIEFING.byTheEndYouWill}</p>
    <ul>
      <li>{MISSION_BRIEFING.whatIsLLM}</li>
      <li>{MISSION_BRIEFING.howItGetsConverted}</li>
      <li>{MISSION_BRIEFING.tooling}</li>
      <li>{MISSION_BRIEFING.whyMatters}</li>
    </ul>
  </div>
</section>

<style>
  .mission-briefing {
    margin: 3rem 0;
    padding: 2rem;
    background: linear-gradient(135deg, var(--panel) 0%, rgba(34, 199, 176, 0.05) 100%);
    border: 2px dashed var(--signal);
    border-radius: 2px;
  }
  
  .briefing-header {
    margin-bottom: 1.5rem;
  }
  
  .briefing-header h2 {
    margin: 0 0 1rem;
    font-size: 1.5rem;
    text-transform: uppercase;
    border: none;
    padding: 0;
    color: var(--signal);
  }
  
  .briefing-header p {
    color: var(--text-dim);
    line-height: 1.6;
  }
  
  .briefing-header em {
    color: var(--signal);
    font-style: italic;
  }
  
  .comic-strip-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 1rem 0;
    margin: 1.5rem 0;
    -webkit-overflow-scrolling: touch;
  }
  
  .comic-strip-scroll img {
    display: block;
    margin: 0;
    min-width: 100%;
    height: auto;
  }
  
  .briefing-promise {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--signal);
  }
  
  .briefing-promise strong {
    color: var(--signal);
  }
  
  .briefing-promise ul {
    margin: 1rem 0 0;
    padding-left: 1.5rem;
  }
  
  .briefing-promise li {
    margin: 0.5rem 0;
    color: var(--text);
  }
  
  @media (max-width: 768px) {
    .mission-briefing {
      padding: 1.5rem;
      margin: 2rem 0;
    }
    
    .briefing-header p {
      font-size: 0.95rem;
    }
  }
</style>
