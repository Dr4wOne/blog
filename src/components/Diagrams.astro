---
import { COLORS } from '../constants/colors';
import { DIAGRAM_TYPOGRAPHY, DIAGRAM_SIZING, DIAGRAM_COLORS, DiagramType, DIAGRAM_VIEWBOX } from '../constants/diagrams';

interface Props {
  type: DiagramType;
  title?: string;
}

const { type, title } = Astro.props;
---

{type === DiagramType.D1 && (
  <figure class="diagram">
    <svg viewBox={DIAGRAM_VIEWBOX[DiagramType.D1]} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .text-input { font-family: monospace; font-size: ${DIAGRAM_TYPOGRAPHY.fontMain}px; fill: ${DIAGRAM_COLORS.text}; }
          .label { font-size: ${DIAGRAM_TYPOGRAPHY.fontLabel}px; fill: ${DIAGRAM_COLORS.border}; font-weight: bold; }
          .token-label { font-size: ${DIAGRAM_TYPOGRAPHY.fontSmall}px; fill: ${DIAGRAM_COLORS.text}; font-weight: bold; }
          .arrow { stroke: ${DIAGRAM_COLORS.border}; stroke-width: ${DIAGRAM_SIZING.strokeThick}; fill: none; marker-end: url(#arrowhead); }
          .predict { fill: ${DIAGRAM_COLORS.accent}; }
        `}</style>
        <marker id="arrowhead" markerWidth={DIAGRAM_SIZING.markerSize} markerHeight={DIAGRAM_SIZING.markerSize} refX={DIAGRAM_SIZING.markerRefX} refY={DIAGRAM_SIZING.markerRefY} orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill={DIAGRAM_COLORS.border}/>
        </marker>
      </defs>

      <g>
        <text class="label" x={DIAGRAM_SPACING.padding} y={DIAGRAM_SPACING.labelOffset}>Step 1: Input text</text>
        <rect fill={DIAGRAM_COLORS.white} stroke={DIAGRAM_COLORS.border} stroke-width={DIAGRAM_SIZING.strokeStandard} x={DIAGRAM_SPACING.padding} y="40" width="180" height="50" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="text-input" x="45" y="70">"Write a haiku about"</text>

        <path class="arrow" d="M 210 65 L 250 65"/>

        <text class="label" x="270" y={DIAGRAM_SPACING.labelOffset}>Step 2: Model predicts</text>
        <circle fill={DIAGRAM_COLORS.accent} cx="330" cy="65" r={DIAGRAM_SIZING.circleRadius}/>
        <text class="token-label" x="330" y="72" text-anchor="middle">AI</text>

        <path class="arrow" d="M 360 65 L 400 65"/>

        <text class="label" x="420" y={DIAGRAM_SPACING.labelOffset}>Step 3: Append</text>
        <rect fill={DIAGRAM_COLORS.white} stroke={DIAGRAM_COLORS.accent} stroke-width={DIAGRAM_SIZING.strokeStandard} x="420" y="40" width="180" height="50" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="text-input" x="435" y="70">"Write a haiku about AI"</text>
      </g>

      <g>
        <text class="label" x={DIAGRAM_SPACING.padding} y="140">Step 4: Same input + output</text>
        <rect fill={DIAGRAM_COLORS.white} stroke={DIAGRAM_COLORS.border} stroke-width={DIAGRAM_SIZING.strokeStandard} x={DIAGRAM_SPACING.padding} y="155" width="230" height="50" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="text-input" x="45" y="185">"Write a haiku about AI"</text>

        <path class="arrow" d="M 260 180 L 300 180"/>

        <text class="label" x="320" y="140">Step 5: Predicts next</text>
        <circle fill={DIAGRAM_COLORS.accent} cx="380" cy="180" r={DIAGRAM_SIZING.circleRadius}/>
        <text class="token-label" x="380" y="187" text-anchor="middle">that</text>

        <path class="arrow" d="M 410 180 L 450 180"/>

        <rect fill={DIAGRAM_COLORS.white} stroke={DIAGRAM_COLORS.accent} stroke-width={DIAGRAM_SIZING.strokeStandard} x="450" y="155" width="280" height="50" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="text-input" x="465" y="185">"Write a haiku about AI that"</text>
      </g>

      <g>
        <text class="label" x={DIAGRAM_SPACING.padding} y="260">Step 6: Continue...</text>
        <rect fill={DIAGRAM_COLORS.white} stroke={DIAGRAM_COLORS.border} stroke-width={DIAGRAM_SIZING.strokeStandard} x={DIAGRAM_SPACING.padding} y="275" width="700" height="50" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="text-input" x="45" y="305">"Write a haiku about AI that learns" (continues token by token)</text>
      </g>

      <path stroke={DIAGRAM_COLORS.warm} stroke-width={DIAGRAM_SIZING.strokeThick} stroke-dasharray="5,5" fill="none" d="M 750 155 L 750 310 L 15 310 L 15 155"/>
      <text style="font-size: {DIAGRAM_TYPOGRAPHY.fontSmall}px; fill: {DIAGRAM_COLORS.warm}; font-weight: bold;" x={DIAGRAM_SPACING.padding} y="330">← Loops back. Each iteration: takes full text so far + predicts one more token</text>
    </svg>
    <figcaption>FIG 1.1 — Autocomplete in action: take the full text you have, predict one token, append it, repeat. The text grows with each step.</figcaption>
  </figure>
)}

{type === DiagramType.D2 && (
  <figure class="diagram">
    <svg viewBox={DIAGRAM_VIEWBOX[DiagramType.D2]} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .box { fill: ${DIAGRAM_COLORS.white}; stroke: ${DIAGRAM_COLORS.border}; stroke-width: ${DIAGRAM_SIZING.strokeStandard}; }
          .text { font-family: monospace; font-weight: bold; font-size: ${DIAGRAM_TYPOGRAPHY.fontMain}px; fill: ${DIAGRAM_COLORS.text}; }
          .label { font-size: ${DIAGRAM_TYPOGRAPHY.fontSmall}px; fill: #4A4A6A; }
          .arrow { stroke: ${DIAGRAM_COLORS.border}; stroke-width: ${DIAGRAM_SIZING.strokeStandard}; fill: none; marker-end: url(#arrowhead); }
          .learning { font-size: ${DIAGRAM_TYPOGRAPHY.fontLabel}px; font-weight: bold; }
        `}</style>
        <marker id="arrowhead" markerWidth={DIAGRAM_SIZING.markerSize} markerHeight={DIAGRAM_SIZING.markerSize} refX={DIAGRAM_SIZING.markerRefX} refY={DIAGRAM_SIZING.markerRefY} orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill={DIAGRAM_COLORS.border}/>
        </marker>
      </defs>

      <g>
        <rect class="box" x="20" y="30" width="220" height="140" rx="4" fill={DIAGRAM_COLORS.softBg}/>
        <text class="learning" x="130" y="60" text-anchor="middle" fill={DIAGRAM_COLORS.border}>Phase 1: Pre-training</text>

        <rect fill={DIAGRAM_COLORS.white} stroke={DIAGRAM_COLORS.border} stroke-width="1.5" x="50" y="75" width="50" height="15" rx="2"/>
        <text class="label" x="75" y="86" text-anchor="middle" font-size="9">Books</text>

        <rect fill={DIAGRAM_COLORS.white} stroke={DIAGRAM_COLORS.border} stroke-width="1.5" x="45" y="95" width="60" height="15" rx="2"/>
        <text class="label" x="75" y="106" text-anchor="middle" font-size="9">Wikipedia</text>

        <rect fill={DIAGRAM_COLORS.white} stroke={DIAGRAM_COLORS.border} stroke-width="1.5" x="40" y="115" width="70" height="15" rx="2"/>
        <text class="label" x="75" y="126" text-anchor="middle" font-size="9">Code + web</text>

        <text class="label" x="130" y="150" text-anchor="middle" font-size="10">Learns language</text>

        <path class="arrow" d="M 240 100 L 280 100"/>
      </g>

      <g>
        <rect class="box" x="280" y="30" width="220" height="140" rx="4" fill={DIAGRAM_COLORS.softBgWarm}/>
        <text class="learning" x="390" y="60" text-anchor="middle" fill={DIAGRAM_COLORS.warm}>Phase 2: Fine-tuning</text>

        <g>
          <circle cx="305" cy="85" r="3" fill={DIAGRAM_COLORS.warm}/>
          <text class="label" x="315" y="90" font-size="10">Question →</text>
          <text class="label" x="315" y="103" font-size="10">Good Answer</text>
        </g>

        <g>
          <circle cx="305" cy="125" r="3" fill={DIAGRAM_COLORS.warm}/>
          <text class="label" x="315" y="130" font-size="10">Prompt →</text>
          <text class="label" x="315" y="143" font-size="10">Instruction Followed</text>
        </g>

        <text class="label" x="390" y="150" text-anchor="middle" font-size="10">Learns to follow</text>

        <path class="arrow" d="M 500 100 L 540 100"/>
      </g>

      <g>
        <rect class="box" x="540" y="30" width="220" height="140" rx="4" fill={DIAGRAM_COLORS.softBgCyan}/>
        <text class="learning" x="650" y="60" text-anchor="middle" fill={DIAGRAM_COLORS.accent}>Phase 3: Alignment</text>

        <g>
          <circle cx="565" cy="90" r="15" fill="none" stroke={DIAGRAM_COLORS.accent} stroke-width="1.5"/>
          <text style="font-size: 10px; fill: {DIAGRAM_COLORS.accent}; font-weight: bold;" x="565" y="95" text-anchor="middle">👍</text>
        </g>

        <g>
          <circle cx="625" cy="90" r="15" fill="none" stroke={DIAGRAM_COLORS.accent} stroke-width="1.5"/>
          <text style="font-size: 10px; fill: {DIAGRAM_COLORS.accent}; font-weight: bold;" x="625" y="95" text-anchor="middle">👎</text>
        </g>

        <text class="label" x="595" y="125" text-anchor="middle" font-size="10">Human compares</text>
        <text class="label" x="595" y="138" text-anchor="middle" font-size="10">answers, votes</text>
        <text class="label" x="650" y="150" text-anchor="middle" font-size="10">Learns preferences</text>
      </g>

      <rect fill={DIAGRAM_COLORS.bg} stroke="#D99D0F" stroke-width="1.5" x="20" y="190" width="740" height="120" rx="4"/>
      <text class="learning" x="400" y="220" text-anchor="middle" fill=${DIAGRAM_COLORS.text}>Result: Helpful, safe, instruction-following assistant</text>

      <g>
        <text class="label" x="60" y="250" font-size="11">✓ Understands language</text>
        <text class="label" x="60" y="270" font-size="11">✓ Follows instructions</text>
        <text class="label" x="60" y="290" font-size="11">✓ Helpful & safe</text>
      </g>

      <g>
        <text class="label" x="420" y="250" font-size="11">✓ Can reason about facts</text>
        <text class="label" x="420" y="270" font-size="11">✓ Refuses dangerous requests</text>
        <text class="label" x="420" y="290" font-size="11">✓ Natural conversation</text>
      </g>
    </svg>
    <figcaption>FIG 1.2 — Three sequential phases: pre-training teaches language from text, fine-tuning teaches instruction-following from examples, alignment teaches safety from human feedback.</figcaption>
  </figure>
)}

{type === DiagramType.D3 && (
  <figure class="diagram">
    <svg viewBox={DIAGRAM_VIEWBOX[DiagramType.D3]} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .word { font-family: monospace; font-weight: bold; font-size: 16px; fill: ${DIAGRAM_COLORS.text}; }
          .token { font-family: monospace; font-weight: bold; font-size: ${DIAGRAM_TYPOGRAPHY.fontLabel}px; fill: ${DIAGRAM_COLORS.text}; }
          .label { font-size: ${DIAGRAM_TYPOGRAPHY.fontSmall}px; fill: #D99D0F; font-weight: bold; }
          .arrow { stroke: ${DIAGRAM_COLORS.border}; stroke-width: ${DIAGRAM_SIZING.strokeStandard}; fill: none; marker-end: url(#arrowhead); }
          .brick { fill: ${DIAGRAM_COLORS.white}; stroke: ${DIAGRAM_COLORS.border}; stroke-width: 2.5; }
          .brick-count { font-size: ${DIAGRAM_TYPOGRAPHY.fontCaption}px; fill: #4A4A6A; font-weight: bold; }
        `}</style>
        <marker id="arrowhead" markerWidth={DIAGRAM_SIZING.markerSize} markerHeight={DIAGRAM_SIZING.markerSize} refX={DIAGRAM_SIZING.markerRefX} refY={DIAGRAM_SIZING.markerRefY} orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill=${DIAGRAM_COLORS.border}/>
        </marker>
      </defs>

      <g>
        <text class="label" x="50" y="40" font-size="13">RARE/LONG WORD:</text>
        <text class="word" x="50" y="70">"unconstitutionally"</text>

        <path class="arrow" d="M 50 80 L 50 110"/>

        <text class="label" x="50" y="130">Breaks into tokens:</text>

        <rect class="brick" x="20" y="145" width="80" height="45" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="token" x="60" y="173" text-anchor="middle">uncon</text>

        <rect class="brick" x="110" y="145" width="80" height="45" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="token" x="150" y="173" text-anchor="middle">stit</text>

        <rect class="brick" x="200" y="145" width="80" height="45" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="token" x="240" y="173" text-anchor="middle">ution</text>

        <rect class="brick" x="290" y="145" width="80" height="45" rx={DIAGRAM_SIZING.borderRadius}/>
        <text class="token" x="330" y="173" text-anchor="middle">ally</text>

        <text class="brick-count" x="180" y="210">= 4 tokens</text>
      </g>

      <g>
        <text class="label" x="450" y="40" font-size="13">COMMON WORD:</text>
        <text class="word" x="450" y="70">"house"</text>

        <path class="arrow" d="M 450 80 L 450 110"/>

        <text class="label" x="450" y="130">Stays as one token:</text>

        <rect class="brick" x="420" y="145" width="120" height="45" rx=${DIAGRAM_SIZING.borderRadius}/>
        <text class="token" x="480" y="173" text-anchor="middle">house</text>

        <text class="brick-count" x="450" y="210">= 1 token</text>
      </g>

      <rect fill={DIAGRAM_COLORS.softBg} stroke=${DIAGRAM_COLORS.border} stroke-width=${DIAGRAM_SIZING.strokeStandard} x="20" y="240" width="710" height="65" rx={DIAGRAM_SIZING.borderRadius}/>
      <text class="label" x="375" y="260" text-anchor="middle" font-size="12">⚡ KEY INSIGHT:</text>
      <text style="font-size: 11px; fill: ${DIAGRAM_COLORS.text};" x="375" y="280" text-anchor="middle">The model SEES tokens, not letters. It doesn't know which letters are in "strawberry"</text>
      <text style="font-size: 11px; fill: ${DIAGRAM_COLORS.text};" x="375" y="295" text-anchor="middle">unless they're encoded differently. This is why LLMs can't count letters reliably.</text>
    </svg>
    <figcaption>FIG 1.3 — Text tokenizes differently: common words stay whole (1 token), rare/long words split into pieces (3-5 tokens). The model processes tokens, not letters.</figcaption>
  </figure>
)}

{type === DiagramType.D4 && (
  <figure class="diagram">
    <svg viewBox={DIAGRAM_VIEWBOX[DiagramType.D4]} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .axis { stroke: ${DIAGRAM_COLORS.border}; stroke-width: 1.5; opacity: 0.3; }
          .point { fill: ${DIAGRAM_COLORS.accent}; }
          .label { font-size: ${DIAGRAM_TYPOGRAPHY.fontLabel}px; fill: ${DIAGRAM_COLORS.text}; font-weight: bold; }
          .small-label { font-size: ${DIAGRAM_TYPOGRAPHY.fontSmall}px; fill: #4A4A6A; }
        `}</style>
      </defs>

      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path class="axis" d="M 40 0 L 0 0 0 40" fill="none" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="800" height="400" fill={DIAGRAM_COLORS.bg} />
      <rect width="800" height="350" y="20" fill="url(#grid)" opacity="0.5"/>

      <text class="label" x="400" y="35" text-anchor="middle" font-size="14">Semantic Space: Meanings as Coordinates</text>

      <line class="axis" x1="100" y1="300" x2="700" y2="300" stroke-width="2"/>
      <line class="axis" x1="100" y1="50" x2="100" y2="300" stroke-width="2"/>

      <text class="small-label" x="710" y="305" font-size="11">Formality →</text>
      <text class="small-label" x="50" y="45" font-size="11">↑ Emotion</text>

      <circle class="point" cx="280" cy="180" r="8" />
      <text class="label" x="280" y="210">"dog"</text>

      <circle class="point" cx="300" cy="160" r="8" />
      <text class="label" x="300" y="190">"puppy"</text>

      <circle class="point" cx="260" cy="170" r="8" />
      <text class="label" x="260" y="200">"canine"</text>

      <circle fill="none" stroke=${DIAGRAM_COLORS.accent} stroke-width="1" stroke-dasharray="4,4" cx="280" cy="170" r="50" opacity="0.5"/>
      <text class="small-label" x="280" y="235" text-anchor="middle">← Semantically close</text>

      <circle class="point" cx="550" cy="120" r="8" />
      <text class="label" x="550" y="150">"refrigerator"</text>

      <circle class="point" cx="600" cy="100" r="8" />
      <text class="label" x="600" y="130">"abstract"</text>

      <path stroke=${DIAGRAM_COLORS.warm} stroke-width="2" stroke-dasharray="3,3" d="M 310 180 L 520 140"/>
      <text class="small-label" x="415" y="155" text-anchor="middle" fill=${DIAGRAM_COLORS.warm}>Far apart = Different meaning</text>

      <rect fill=${DIAGRAM_COLORS.softBg} stroke=${DIAGRAM_COLORS.border} stroke-width="1.5" x="50" y="330" width="700" height="60" rx=${DIAGRAM_SIZING.borderRadius}/>
      <text class="label" x="400" y="350" text-anchor="middle">⚡ Embeddings map MEANINGS to coordinates. Similarity = proximity.</text>
      <text class="small-label" x="400" y="370" text-anchor="middle">Search, clustering, and memory all work by measuring distance.</text>
    </svg>
    <figcaption>FIG 3.1 — Semantic space: embeddings represent meanings as coordinates. Texts with similar meanings cluster together.</figcaption>
  </figure>
)}

{type === DiagramType.D5 && (
  <figure class="diagram">
    <svg viewBox={DIAGRAM_VIEWBOX[DiagramType.D5]} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .box { fill: ${DIAGRAM_COLORS.white}; stroke: ${DIAGRAM_COLORS.border}; stroke-width: ${DIAGRAM_SIZING.strokeStandard}; }
          .text { font-family: monospace; font-weight: bold; font-size: ${DIAGRAM_TYPOGRAPHY.fontMain}px; fill: ${DIAGRAM_COLORS.text}; }
          .label { font-size: ${DIAGRAM_TYPOGRAPHY.fontSmall}px; fill: #4A4A6A; }
          .arrow { stroke: ${DIAGRAM_COLORS.border}; stroke-width: ${DIAGRAM_SIZING.strokeStandard}; fill: none; marker-end: url(#arrowhead); }
          .title { font-size: ${DIAGRAM_TYPOGRAPHY.fontLabel}px; font-weight: bold; fill: ${DIAGRAM_COLORS.text}; }
        `}</style>
        <marker id="arrowhead" markerWidth=${DIAGRAM_SIZING.markerSize} markerHeight=${DIAGRAM_SIZING.markerSize} refX=${DIAGRAM_SIZING.markerRefX} refY=${DIAGRAM_SIZING.markerRefY} orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill=${DIAGRAM_COLORS.border}/>
        </marker>
      </defs>

      <text class="title" x="400" y="30" text-anchor="middle">Context Window: Everything the Model Sees at Once</text>

      <g>
        <rect class="box" x="30" y="60" width="140" height="60" rx="3"/>
        <text class="label" x="100" y="78" text-anchor="middle" font-weight="bold" font-size="11">Your Prompt</text>
        <text class="text" x="100" y="105" text-anchor="middle" font-size="12">1200 tokens</text>

        <rect class="box" x="190" y="60" width="140" height="60" rx="3"/>
        <text class="label" x="260" y="78" text-anchor="middle" font-weight="bold" font-size="11">Open Files</text>
        <text class="text" x="260" y="105" text-anchor="middle" font-size="12">3500 tokens</text>

        <rect class="box" x="350" y="60" width="140" height="60" rx="3"/>
        <text class="label" x="420" y="78" text-anchor="middle" font-weight="bold" font-size="11">Chat History</text>
        <text class="text" x="420" y="105" text-anchor="middle" font-size="12">2100 tokens</text>

        <rect class="box" x="510" y="60" width="140" height="60" rx="3"/>
        <text class="label" x="580" y="78" text-anchor="middle" font-weight="bold" font-size="11">System Rules</text>
        <text class="text" x="580" y="105" text-anchor="middle" font-size="12">800 tokens</text>

        <rect class="box" x="670" y="60" width="120" height="60" rx="3"/>
        <text class="label" x="730" y="78" text-anchor="middle" font-weight="bold" font-size="11">Memory</text>
        <text class="text" x="730" y="105" text-anchor="middle" font-size="12">400 tokens</text>
      </g>

      <path class="arrow" d="M 100 120 L 100 160"/>
      <path class="arrow" d="M 260 120 L 260 160"/>
      <path class="arrow" d="M 420 120 L 420 160"/>
      <path class="arrow" d="M 580 120 L 580 160"/>
      <path class="arrow" d="M 730 120 L 730 160"/>

      <rect fill=${DIAGRAM_COLORS.softBg} stroke=${DIAGRAM_COLORS.border} stroke-width="3" x="50" y="160" width="700" height="100" rx="4"/>
      <text class="title" x="400" y="195" text-anchor="middle">Context Window (max 200,000 tokens)</text>
      <text class="label" x="400" y="215" text-anchor="middle" font-size="11">Everything combined = 8,000 tokens used (4% of window)</text>
      <text class="label" x="400" y="235" text-anchor="middle" font-size="10" font-style="italic">Each inference, the model processes ALL of this at once</text>

      <rect fill=${DIAGRAM_COLORS.softBgWarm} stroke=${DIAGRAM_COLORS.warm} stroke-width=${DIAGRAM_SIZING.strokeStandard} x="50" y="290" width="700" height="100" rx="4"/>
      <text class="label" x="400" y="315" text-anchor="middle" font-weight="bold" font-size="11">⚡ CONTEXT ENGINEERING:</text>
      <text class="label" x="400" y="335" text-anchor="middle" font-size="10">Include only what's needed. Extra files, old history, or verbose rules shrink your space.</text>
      <text class="label" x="400" y="355" text-anchor="middle" font-size="10">Trim ruthlessly to stay under the limit and keep the model focused on what matters.</text>
      <text class="label" x="400" y="375" text-anchor="middle" font-size="10">This is why "context engineering" is a skill: fitting your whole request in the window wisely.</text>
    </svg>
    <figcaption>FIG 5.1 — Context window assembly: your prompt + open files + history + rules + memory must all fit within the model's finite working memory, measured in tokens.</figcaption>
  </figure>
)}

{type === DiagramType.D9 && (
  <figure class="diagram">
    <svg viewBox={DIAGRAM_VIEWBOX[DiagramType.D9]} xmlns="http://www.w3.org/2000/svg">
      <rect fill=${DIAGRAM_COLORS.bg} stroke=${DIAGRAM_COLORS.border} stroke-width="1" x="20" y="20" width="560" height="260" rx="4"/>
      <text style="font-family: monospace; font-weight: bold; font-size: ${DIAGRAM_TYPOGRAPHY.fontMain}px; fill: ${DIAGRAM_COLORS.text};" x="300" y="50" text-anchor="middle">Temperature: Controlling Randomness</text>

      <text style="font-size: ${DIAGRAM_TYPOGRAPHY.fontLabel}px; fill: #D99D0F;" x="70" y="90" font-weight="bold">Low Temp (0.2)</text>
      <text style="font-size: ${DIAGRAM_TYPOGRAPHY.fontSmall}px; fill: #4A4A6A;" x="70" y="110">Predictable, focused,</text>
      <text style="font-size: ${DIAGRAM_TYPOGRAPHY.fontSmall}px; fill: #4A4A6A;" x="70" y="125">repeats common patterns</text>

      <text style="font-size: ${DIAGRAM_TYPOGRAPHY.fontLabel}px; fill: #D99D0F;" x="300" y="90" font-weight="bold">Medium Temp (1.0)</text>
