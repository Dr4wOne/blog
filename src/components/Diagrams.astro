---
/* Educational SVG diagrams for LLM concepts */

interface Props {
  type: 'D1' | 'D2' | 'D3' | 'D4' | 'D5' | 'D9' | 'D11' | 'D12' | 'D13' | 'D15' | 'D16';
  title?: string;
}

const { type, title } = Astro.props;
---

{type === 'D1' && (
  <figure class="diagram">
    <svg viewBox="0 0 750 400" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .text-input { font-family: monospace; font-size: 14px; fill: #0A0A0F; }
          .label { font-size: 12px; fill: #6C63FF; font-weight: bold; }
          .token-label { font-size: 11px; fill: #0A0A0F; font-weight: bold; }
          .arrow { stroke: #6C63FF; stroke-width: 2.5; fill: none; marker-end: url(#arrowhead); }
          .predict { fill: #00D9FF; }
        `}</style>
        <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill="#6C63FF"/>
        </marker>
      </defs>

      <!-- Step 1 -->
      <g>
        <text class="label" x="30" y="25">Step 1: Input text</text>
        <rect fill="#FFFFFF" stroke="#6C63FF" stroke-width="2" x="30" y="40" width="180" height="50" rx="3"/>
        <text class="text-input" x="45" y="70">"Write a haiku about"</text>

        <path class="arrow" d="M 210 65 L 250 65"/>

        <text class="label" x="270" y="25">Step 2: Model predicts</text>
        <circle fill="#00D9FF" cx="330" cy="65" r="30"/>
        <text class="token-label" x="330" y="72" text-anchor="middle">AI</text>

        <path class="arrow" d="M 360 65 L 400 65"/>

        <text class="label" x="420" y="25">Step 3: Append</text>
        <rect fill="#FFFFFF" stroke="#00D9FF" stroke-width="2" x="420" y="40" width="180" height="50" rx="3"/>
        <text class="text-input" x="435" y="70">"Write a haiku about AI"</text>
      </g>

      <!-- Step 2 (repeat) -->
      <g>
        <text class="label" x="30" y="140">Step 4: Same input + output</text>
        <rect fill="#FFFFFF" stroke="#6C63FF" stroke-width="2" x="30" y="155" width="230" height="50" rx="3"/>
        <text class="text-input" x="45" y="185">"Write a haiku about AI"</text>

        <path class="arrow" d="M 260 180 L 300 180"/>

        <text class="label" x="320" y="140">Step 5: Predicts next</text>
        <circle fill="#00D9FF" cx="380" cy="180" r="30"/>
        <text class="token-label" x="380" y="187" text-anchor="middle">that</text>

        <path class="arrow" d="M 410 180 L 450 180"/>

        <rect fill="#FFFFFF" stroke="#00D9FF" stroke-width="2" x="450" y="155" width="280" height="50" rx="3"/>
        <text class="text-input" x="465" y="185">"Write a haiku about AI that"</text>
      </g>

      <!-- Step 3 (repeat) -->
      <g>
        <text class="label" x="30" y="260">Step 6: Continue...</text>
        <rect fill="#FFFFFF" stroke="#6C63FF" stroke-width="2" x="30" y="275" width="700" height="50" rx="3"/>
        <text class="text-input" x="45" y="305">"Write a haiku about AI that learns" (continues token by token)</text>
      </g>

      <!-- Loop indicator -->
      <path stroke="#FF6B35" stroke-width="2.5" stroke-dasharray="5,5" fill="none" d="M 750 155 L 750 310 L 15 310 L 15 155"/>
      <text style="font-size: 11px; fill: #FF6B35; font-weight: bold;" x="50" y="330">← Loops back. Each iteration: takes full text so far + predicts one more token</text>
    </svg>
    <figcaption>FIG 1.1 — Autocomplete in action: take the full text you have, predict one token, append it, repeat. The text grows with each step.</figcaption>
  </figure>
)}

{type === 'D2' && (
  <figure class="diagram">
    <svg viewBox="0 0 800 350" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .box { fill: #FFFFFF; stroke: #6C63FF; stroke-width: 2; }
          .text { font-family: monospace; font-weight: bold; font-size: 13px; fill: #0A0A0F; }
          .label { font-size: 11px; fill: #4A4A6A; }
          .arrow { stroke: #6C63FF; stroke-width: 2; fill: none; marker-end: url(#arrowhead); }
          .learning { font-size: 12px; font-weight: bold; }
        `}</style>
        <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill="#6C63FF"/>
        </marker>
      </defs>

      <!-- Phase 1 -->
      <g>
        <rect class="box" x="20" y="30" width="220" height="140" rx="4" fill="#E8E8FF"/>
        <text class="learning" x="130" y="60" text-anchor="middle" fill="#6C63FF">Phase 1: Pre-training</text>

        <!-- Books stacking -->
        <rect fill="#FFFFFF" stroke="#6C63FF" stroke-width="1.5" x="50" y="75" width="50" height="15" rx="2"/>
        <text class="label" x="75" y="86" text-anchor="middle" font-size="9">Books</text>

        <rect fill="#FFFFFF" stroke="#6C63FF" stroke-width="1.5" x="45" y="95" width="60" height="15" rx="2"/>
        <text class="label" x="75" y="106" text-anchor="middle" font-size="9">Wikipedia</text>

        <rect fill="#FFFFFF" stroke="#6C63FF" stroke-width="1.5" x="40" y="115" width="70" height="15" rx="2"/>
        <text class="label" x="75" y="126" text-anchor="middle" font-size="9">Code + web</text>

        <text class="label" x="130" y="150" text-anchor="middle" font-size="10">Learns language</text>

        <path class="arrow" d="M 240 100 L 280 100"/>
      </g>

      <!-- Phase 2 -->
      <g>
        <rect class="box" x="280" y="30" width="220" height="140" rx="4" fill="#FFE8D9"/>
        <text class="learning" x="390" y="60" text-anchor="middle" fill="#FF6B35">Phase 2: Fine-tuning</text>

        <!-- Q&A pairs -->
        <g>
          <circle cx="305" cy="85" r="3" fill="#FF6B35"/>
          <text class="label" x="315" y="90" font-size="10">Question →</text>
          <text class="label" x="315" y="103" font-size="10">Good Answer</text>
        </g>

        <g>
          <circle cx="305" cy="125" r="3" fill="#FF6B35"/>
          <text class="label" x="315" y="130" font-size="10">Prompt →</text>
          <text class="label" x="315" y="143" font-size="10">Instruction Followed</text>
        </g>

        <text class="label" x="390" y="150" text-anchor="middle" font-size="10">Learns to follow</text>

        <path class="arrow" d="M 500 100 L 540 100"/>
      </g>

      <!-- Phase 3 -->
      <g>
        <rect class="box" x="540" y="30" width="220" height="140" rx="4" fill="#D9F5F5"/>
        <text class="learning" x="650" y="60" text-anchor="middle" fill="#00D9FF">Phase 3: Alignment</text>

        <!-- Human feedback -->
        <g>
          <circle cx="565" cy="90" r="15" fill="none" stroke="#00D9FF" stroke-width="1.5"/>
          <text style="font-size: 10px; fill: #00D9FF; font-weight: bold;" x="565" y="95" text-anchor="middle">👍</text>
        </g>

        <g>
          <circle cx="625" cy="90" r="15" fill="none" stroke="#00D9FF" stroke-width="1.5"/>
          <text style="font-size: 10px; fill: #00D9FF; font-weight: bold;" x="625" y="95" text-anchor="middle">👎</text>
        </g>

        <text class="label" x="595" y="125" text-anchor="middle" font-size="10">Human compares</text>
        <text class="label" x="595" y="138" text-anchor="middle" font-size="10">answers, votes</text>
        <text class="label" x="650" y="150" text-anchor="middle" font-size="10">Learns preferences</text>
      </g>

      <!-- Bottom: Result -->
      <rect fill="#F5F5F7" stroke="#D99D0F" stroke-width="1.5" x="20" y="190" width="740" height="120" rx="4"/>
      <text class="learning" x="400" y="220" text-anchor="middle" fill="#0A0A0F">Result: Helpful, safe, instruction-following assistant</text>

      <g>
        <text class="label" x="60" y="250" font-size="11">✓ Understands language</text>
        <text class="label" x="60" y="270" font-size="11">✓ Follows instructions</text>
        <text class="label" x="60" y="290" font-size="11">✓ Helpful & safe</text>
      </g>

      <g>
        <text class="label" x="420" y="250" font-size="11">✓ Can reason about facts</text>
        <text class="label" x="420" y="270" font-size="11">✓ Refuses dangerous requests</text>
        <text class="label" x="420" y="290" font-size="11">✓ Natural conversation</text>
      </g>
    </svg>
    <figcaption>FIG 1.2 — Three sequential phases: pre-training teaches language from text, fine-tuning teaches instruction-following from examples, alignment teaches safety from human feedback.</figcaption>
  </figure>
)}

{type === 'D3' && (
  <figure class="diagram">
    <svg viewBox="0 0 750 320" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .word { font-family: monospace; font-weight: bold; font-size: 16px; fill: #0A0A0F; }
          .token { font-family: monospace; font-weight: bold; font-size: 13px; fill: #0A0A0F; }
          .label { font-size: 11px; fill: #D99D0F; font-weight: bold; }
          .arrow { stroke: #6C63FF; stroke-width: 2; fill: none; marker-end: url(#arrowhead); }
          .brick { fill: #FFFFFF; stroke: #6C63FF; stroke-width: 2.5; }
          .brick-count { font-size: 10px; fill: #4A4A6A; font-weight: bold; }
        `}</style>
        <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill="#6C63FF"/>
        </marker>
      </defs>

      <!-- Example 1: "unconstitutionally" -->
      <g>
        <text class="label" x="50" y="40" font-size="13">RARE/LONG WORD:</text>
        <text class="word" x="50" y="70">"unconstitutionally"</text>

        <path class="arrow" d="M 50 80 L 50 110"/>

        <text class="label" x="50" y="130">Breaks into tokens:</text>

        <!-- Token bricks -->
        <rect class="brick" x="20" y="145" width="80" height="45" rx="3"/>
        <text class="token" x="60" y="173" text-anchor="middle">uncon</text>

        <rect class="brick" x="110" y="145" width="80" height="45" rx="3"/>
        <text class="token" x="150" y="173" text-anchor="middle">stit</text>

        <rect class="brick" x="200" y="145" width="80" height="45" rx="3"/>
        <text class="token" x="240" y="173" text-anchor="middle">ution</text>

        <rect class="brick" x="290" y="145" width="80" height="45" rx="3"/>
        <text class="token" x="330" y="173" text-anchor="middle">ally</text>

        <text class="brick-count" x="180" y="210">= 4 tokens</text>
      </g>

      <!-- Example 2: "house" -->
      <g>
        <text class="label" x="450" y="40" font-size="13">COMMON WORD:</text>
        <text class="word" x="450" y="70">"house"</text>

        <path class="arrow" d="M 450 80 L 450 110"/>

        <text class="label" x="450" y="130">Stays as one token:</text>

        <rect class="brick" x="420" y="145" width="120" height="45" rx="3"/>
        <text class="token" x="480" y="173" text-anchor="middle">house</text>

        <text class="brick-count" x="450" y="210">= 1 token</text>
      </g>

      <!-- Key insight box -->
      <rect fill="#E8E8FF" stroke="#6C63FF" stroke-width="2" x="20" y="240" width="710" height="65" rx="4"/>
      <text class="label" x="375" y="260" text-anchor="middle" font-size="12">⚡ KEY INSIGHT:</text>
      <text style="font-size: 11px; fill: #0A0A0F;" x="375" y="280" text-anchor="middle">The model SEES tokens, not letters. It doesn't know which letters are in "strawberry"</text>
      <text style="font-size: 11px; fill: #0A0A0F;" x="375" y="295" text-anchor="middle">unless they're encoded differently. This is why LLMs can't count letters reliably.</text>
    </svg>
    <figcaption>FIG 1.3 — Text tokenizes differently: common words stay whole (1 token), rare/long words split into pieces (3-5 tokens). The model processes tokens, not letters.</figcaption>
  </figure>
)}

{type === 'D5' && (
  <figure class="diagram">
    <svg viewBox="0 0 800 420" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .box { fill: #FFFFFF; stroke: #6C63FF; stroke-width: 2; }
          .text { font-family: monospace; font-weight: bold; font-size: 13px; fill: #0A0A0F; }
          .label { font-size: 11px; fill: #4A4A6A; }
          .arrow { stroke: #6C63FF; stroke-width: 2; fill: none; marker-end: url(#arrowhead); }
          .title { font-size: 14px; font-weight: bold; fill: #0A0A0F; }
        `}</style>
        <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill="#6C63FF"/>
        </marker>
      </defs>

      <!-- Title -->
      <text class="title" x="400" y="30" text-anchor="middle">Context Window: Everything the Model Sees at Once</text>

      <!-- Input sources -->
      <g>
        <!-- Your message -->
        <rect class="box" x="30" y="60" width="140" height="60" rx="3"/>
        <text class="label" x="100" y="78" text-anchor="middle" font-weight="bold" font-size="11">Your Prompt</text>
        <text class="text" x="100" y="105" text-anchor="middle" font-size="12">1200 tokens</text>

        <!-- Open files -->
        <rect class="box" x="190" y="60" width="140" height="60" rx="3"/>
        <text class="label" x="260" y="78" text-anchor="middle" font-weight="bold" font-size="11">Open Files</text>
        <text class="text" x="260" y="105" text-anchor="middle" font-size="12">3500 tokens</text>

        <!-- Chat history -->
        <rect class="box" x="350" y="60" width="140" height="60" rx="3"/>
        <text class="label" x="420" y="78" text-anchor="middle" font-weight="bold" font-size="11">Chat History</text>
        <text class="text" x="420" y="105" text-anchor="middle" font-size="12">2100 tokens</text>

        <!-- System instructions -->
        <rect class="box" x="510" y="60" width="140" height="60" rx="3"/>
        <text class="label" x="580" y="78" text-anchor="middle" font-weight="bold" font-size="11">System Rules</text>
        <text class="text" x="580" y="105" text-anchor="middle" font-size="12">800 tokens</text>

        <!-- Memory/Session -->
        <rect class="box" x="670" y="60" width="120" height="60" rx="3"/>
        <text class="label" x="730" y="78" text-anchor="middle" font-weight="bold" font-size="11">Memory</text>
        <text class="text" x="730" y="105" text-anchor="middle" font-size="12">400 tokens</text>
      </g>

      <!-- Arrows pointing down -->
      <path class="arrow" d="M 100 120 L 100 160"/>
      <path class="arrow" d="M 260 120 L 260 160"/>
      <path class="arrow" d="M 420 120 L 420 160"/>
      <path class="arrow" d="M 580 120 L 580 160"/>
      <path class="arrow" d="M 730 120 L 730 160"/>

      <!-- The context window itself -->
      <rect fill="#E8E8FF" stroke="#6C63FF" stroke-width="3" x="50" y="160" width="700" height="100" rx="4"/>
      <text class="title" x="400" y="195" text-anchor="middle">Context Window (max 200,000 tokens)</text>
      <text class="label" x="400" y="215" text-anchor="middle" font-size="11">Everything combined = 8,000 tokens used (4% of window)</text>
      <text class="label" x="400" y="235" text-anchor="middle" font-size="10" font-style="italic">Each inference, the model processes ALL of this at once</text>

      <!-- Key insight -->
      <rect fill="#FFE8D9" stroke="#FF6B35" stroke-width="2" x="50" y="290" width="700" height="100" rx="4"/>
      <text class="label" x="400" y="315" text-anchor="middle" font-weight="bold" font-size="11">⚡ CONTEXT ENGINEERING:</text>
      <text class="label" x="400" y="335" text-anchor="middle" font-size="10">Include only what's needed. Extra files, old history, or verbose rules shrink your space.</text>
      <text class="label" x="400" y="355" text-anchor="middle" font-size="10">Trim ruthlessly to stay under the limit and keep the model focused on what matters.</text>
      <text class="label" x="400" y="375" text-anchor="middle" font-size="10">This is why "context engineering" is a skill: fitting your whole request in the window wisely.</text>
    </svg>
    <figcaption>FIG 5.1 — Context window assembly: your prompt + open files + history + rules + memory must all fit within the model's finite working memory, measured in tokens.</figcaption>
  </figure>
)}

{type === 'D4' && (
  <figure class="diagram">
    <svg viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .axis { stroke: #6C63FF; stroke-width: 1.5; opacity: 0.3; }
          .point { fill: #00D9FF; }
          .label { font-size: 12px; fill: #0A0A0F; font-weight: bold; }
          .small-label { font-size: 10px; fill: #4A4A6A; }
        `}</style>
      </defs>

      <!-- Grid background (semantic space) -->
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path class="axis" d="M 40 0 L 0 0 0 40" fill="none" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="800" height="400" fill="#F5F5F7" />
      <rect width="800" height="350" y="20" fill="url(#grid)" opacity="0.5"/>

      <!-- Title -->
      <text class="label" x="400" y="35" text-anchor="middle" font-size="14">Semantic Space: Meanings as Coordinates</text>

      <!-- Axis lines -->
      <line class="axis" x1="100" y1="300" x2="700" y2="300" stroke-width="2"/>
      <line class="axis" x1="100" y1="50" x2="100" y2="300" stroke-width="2"/>

      <!-- Axis labels -->
      <text class="small-label" x="710" y="305" font-size="11">Formality →</text>
      <text class="small-label" x="50" y="45" font-size="11">↑ Emotion</text>

      <!-- Data points (meanings) -->
      <!-- Dog family -->
      <circle class="point" cx="280" cy="180" r="8" />
      <text class="label" x="280" y="210">"dog"</text>

      <circle class="point" cx="300" cy="160" r="8" />
      <text class="label" x="300" y="190">"puppy"</text>

      <circle class="point" cx="260" cy="170" r="8" />
      <text class="label" x="260" y="200">"canine"</text>

      <!-- Similar semantic region (close together) -->
      <circle fill="none" stroke="#00D9FF" stroke-width="1" stroke-dasharray="4,4" cx="280" cy="170" r="50" opacity="0.5"/>
      <text class="small-label" x="280" y="235" text-anchor="middle">← Semantically close</text>

      <!-- Far away (different meaning) -->
      <circle class="point" cx="550" cy="120" r="8" />
      <text class="label" x="550" y="150">"refrigerator"</text>

      <circle class="point" cx="600" cy="100" r="8" />
      <text class="label" x="600" y="130">"abstract"</text>

      <!-- Distance indicator -->
      <path stroke="#FF6B35" stroke-width="2" stroke-dasharray="3,3" d="M 310 180 L 520 140"/>
      <text class="small-label" x="415" y="155" text-anchor="middle" fill="#FF6B35">Far apart = Different meaning</text>

      <!-- Key insight -->
      <rect fill="#E8E8FF" stroke="#6C63FF" stroke-width="1.5" x="50" y="330" width="700" height="60" rx="3"/>
      <text class="label" x="400" y="350" text-anchor="middle">⚡ Embeddings map MEANINGS to coordinates. Similarity = proximity.</text>
      <text class="small-label" x="400" y="370" text-anchor="middle">Search, clustering, and memory all work by measuring distance.</text>
    </svg>
    <figcaption>FIG 3.1 — Semantic space: embeddings represent meanings as coordinates. Texts with similar meanings cluster together.</figcaption>
  </figure>
)}

{type === 'D11' && (
  <figure class="diagram">
    <svg viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <style>{`
          .layer-box { fill: #FFFFFF; stroke: #6C63FF; stroke-width: 2; }
          .label { font-size: 12px; fill: #0A0A0F; font-weight: bold; }
          .small-label { font-size: 10px; fill: #4A4A6A; }
          .arrow { stroke: #6C63FF; stroke-width: 2; fill: none; marker-end: url(#arrowhead); }
          .focus-line { stroke: #00D9FF; stroke-width: 2; opacity: 0.6; }
        `}</style>
        <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
          <polygon points="0 0, 10 3, 0 6" fill="#6C63FF"/>
        </marker>
      </defs>

      <!-- Title -->
      <text class="label" x="400" y="35" text-anchor="middle" font-size="14">Transformers: Multi-Head Attention Layers</text>

      <!-- Input tokens -->
      <g>
        <text class="small-label" x="50" y="85">Tokens:</text>
        <rect class="layer-box" x="50" y="95" width="45" height="35" rx="2"/>
        <text class="label" x="72.5" y="118" text-anchor="middle" font-size="11">"I"</text>

        <rect class="layer-box" x="105" y="95" width="45" height="35" rx="2"/>
        <text class="label" x="127.5" y="118" text-anchor="middle" font-size="11">"took"</text>

        <rect class="layer-box" x="160" y="95" width="45" height="35" rx="2"/>
        <text class="label" x="182.5" y="118" text-anchor="middle" font-size="11">"the"</text>

        <rect class="layer-box" x="215" y="95" width="45" height="35" rx="2"/>
        <text class="label" x="237.5" y="118" text-anchor="middle" font-size="11">"dog"</text>

        <rect class="layer-box" x="270" y="95" width="45" height="35" rx="2"/>
        <text class="label" x="292.5" y="118" text-anchor="middle" font-size="11">"to"</text>
      </g>

      <!-- Attention connections -->
      <path class="focus-line" d="M 237.5 130 Q 200 160 290 160" opacity="0.8"/>
      <circle fill="none" stroke="#00D9FF" stroke-width="1.5" stroke-dasharray="2,2" cx="260" cy="160" r="25" opacity="0.4"/>
      <text class="small-label" x="260" y="200" text-anchor="middle" fill="#00D9FF">Attention: "to the dog"</text>

      <!-- Layer stack -->
      <g>
        <text class="small-label" x="380" y="85">Processing:</text>

        <rect class="layer-box" x="370" y="100" width="200" height="30" rx="2" fill="#E8E8FF"/>
        <text class="label" x="470" y="121" text-anchor="middle" font-size="11">Attention Layer 1</text>

        <path class="arrow" d="M 470 130 L 470 150"/>

        <rect class="layer-box" x="370" y="150" width="200" height="30" rx="2" fill="#E8E8FF"/>
        <text class="label" x="470" y="171" text-anchor="middle" font-size="11">Attention Layer 2</text>

        <path class="arrow" d="M 470 180 L 470 200"/>

        <rect class="layer-box" x="370" y="200" width="200" height="30" rx="2" fill="#E8E8FF"/>
        <text class="label" x="470" y="221" text-anchor="middle" font-size="11">... (many more)</text>

        <path class="arrow" d="M 470 230 L 470 250"/>

        <rect class="layer-box" x="370" y="250" width="200" height="30" rx="2" fill="#FFE8D9"/>
        <text class="label" x="470" y="271" text-anchor="middle" font-size="11">Output Layer</text>
      </g>

      <!-- Output probabilities -->
      <g>
