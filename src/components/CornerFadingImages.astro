---
/* Four fading images at each corner of the page */
---

<div class="corner-images">
  <!-- Upper left -->
  <div class="corner-image corner-tl">
    <img src="/assets/ref-01.png" alt="" role="presentation" />
  </div>

  <!-- Upper right -->
  <div class="corner-image corner-tr">
    <img src="/assets/ref-02.png" alt="" role="presentation" />
  </div>

  <!-- Bottom left -->
  <div class="corner-image corner-bl">
    <img src="/assets/ref-03.png" alt="" role="presentation" />
  </div>

  <!-- Bottom right -->
  <div class="corner-image corner-br">
    <img src="/assets/ref-04.png" alt="" role="presentation" />
  </div>
</div>

<style>
  .corner-images {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .corner-image {
    position: absolute;
    width: 400px;
    height: 400px;
    opacity: 0;
    filter: blur(40px);
    mix-blend-mode: screen;
  }

  .corner-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Top-left */
  .corner-tl {
    top: -15%;
    left: -15%;
    animation: fade-corner-tl 16s ease-in-out infinite;
  }

  /* Top-right */
  .corner-tr {
    top: -10%;
    right: -10%;
    animation: fade-corner-tr 18s ease-in-out infinite;
  }

  /* Bottom-left */
  .corner-bl {
    bottom: -10%;
    left: -15%;
    animation: fade-corner-bl 14s ease-in-out infinite;
  }

  /* Bottom-right */
  .corner-br {
    bottom: -15%;
    right: -10%;
    animation: fade-corner-br 20s ease-in-out infinite;
  }

  @keyframes fade-corner-tl {
    0%, 100% { opacity: 0; }
    25% { opacity: 0.18; }
    50% { opacity: 0.10; }
    75% { opacity: 0.18; }
  }

  @keyframes fade-corner-tr {
    0%, 100% { opacity: 0; }
    20% { opacity: 0; }
    40% { opacity: 0.20; }
    60% { opacity: 0.10; }
    80% { opacity: 0.20; }
    100% { opacity: 0; }
  }

  @keyframes fade-corner-bl {
    0%, 100% { opacity: 0; }
    15% { opacity: 0.15; }
    35% { opacity: 0.08; }
    55% { opacity: 0.15; }
    75% { opacity: 0; }
  }

  @keyframes fade-corner-br {
    0%, 100% { opacity: 0; }
    30% { opacity: 0.18; }
    50% { opacity: 0.10; }
    70% { opacity: 0.18; }
  }

  @media (prefers-reduced-motion: reduce) {
    .corner-image {
      animation: none !important;
      opacity: 0.02;
    }
  }
</style>
