---
import { TABLE_OF_CONTENTS } from '../constants/labels';

interface Part {
  number: number;
  title: string;
  id: string;
}

interface Props {
  parts: Part[];
}

const { parts } = Astro.props;
---

<nav class="toc">
  <h2 class="toc-title">{TABLE_OF_CONTENTS.title}</h2>
  <ul class="toc-list">
    {parts.map((part) => (
      <li key={part.id}>
        <a href={`#${part.id}`}>
          <span class="part-num">{String(part.number).padStart(2, '0')}</span>
          <span class="part-title">{part.title}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc {
    margin: 3rem 0;
    padding: 2rem;
    background: rgba(26, 26, 38, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
  }

  .toc-title {
    font-size: 1.25rem;
    color: var(--primary);
    margin: 0 0 1.5rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .toc-list li {
    margin: 0;
  }

  .toc-list a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    color: var(--text);
    text-decoration: none;
    border: none;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .toc-list a:hover {
    background: rgba(108, 99, 255, 0.1);
    border-left: 3px solid var(--primary);
    padding-left: 1rem;
  }

  .part-num {
    color: var(--primary);
    font-family: var(--font-code);
    font-size: 0.9rem;
    font-weight: 600;
    min-width: 2ch;
  }

  .part-title {
    color: var(--text);
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .toc {
      padding: 1.5rem;
      margin: 2rem 0;
    }

    .toc-list {
      grid-template-columns: 1fr;
    }
  }
</style>
