---
import Arrow from './Arrow.astro'
import Figure from './Figure.astro'

const parts = [
  { title: 'Builds the context', a: 'rules, files, history,', b: 'tool definitions' },
  { title: 'Runs the loop', a: 'reason, act, observe,', b: 'until done' },
  { title: 'Executes tools', a: 'files, terminal, search,', b: 'MCP servers' },
  { title: 'Guards the doors', a: 'permissions, approvals,', b: 'logs' },
]
---

<Figure caption="A harness wraps the model. The model only reads and writes text; everything that touches your machine happens in the harness.">
  <svg viewBox="0 0 420 392" role="img" aria-labelledby="f-har-t f-har-d">
    <title id="f-har-t">What a harness does</title>
    <desc id="f-har-d">You talk to the harness. The harness builds the context, runs the agent loop, executes tools such as files, the terminal and MCP servers, and guards permissions and approvals. It sends the context to the model through the API of whoever hosts it (the provider) and gets text back.</desc>
    <defs><Arrow id="f-har-a" /></defs>
    <rect x="160" y="0" width="100" height="36" rx="18" class="box" />
    <text x="210" y="23" text-anchor="middle" class="t-strong">You</text>
    <path d="M210 38 V58" class="wire" marker-end="url(#f-har-a)" />
    <rect x="0.75" y="60.75" width="418.5" height="232" rx="8" class="box-ground" />
    <text x="16" y="86" class="t-strong t-large">Harness</text>
    <text x="404" y="86" text-anchor="end" class="t-small t-muted">e.g. Claude Code, Codex, Cursor</text>
    {
      parts.map((p, i) => {
        const x = 16 + (i % 2) * 198
        const y = 104 + Math.floor(i / 2) * 92
        return (
          <g>
            <rect x={x} y={y} width="190" height="80" rx="6" class="box" />
            <text x={x + 14} y={y + 26} class="t-strong">{p.title}</text>
            <text x={x + 14} y={y + 48} class="t-small">{p.a}</text>
            <text x={x + 14} y={y + 66} class="t-small">{p.b}</text>
          </g>
        )
      })
    }
    <path d="M200 296 V340" class="wire" marker-end="url(#f-har-a)" />
    <path d="M220 340 V296" class="wire" marker-end="url(#f-har-a)" />
    <text x="232" y="324" class="t-small t-muted">text in, text out, via the host’s API</text>
    <rect x="110" y="344" width="200" height="44" rx="6" class="box-accent" />
    <text x="210" y="371" text-anchor="middle" class="t-on-accent t-strong">Model</text>
  </svg>
</Figure>
