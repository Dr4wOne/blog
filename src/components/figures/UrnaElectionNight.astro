---
import Figure from './Figure.astro'

// Minutes after 17:00 on 30 Oct 2022 (Brasília time).
const x = (t: number) => 6 + (t / 438) * 348
---

<Figure caption="Election night, 2022 presidential runoff. The winner was declared 2 hours and 56 minutes after the polls closed; every section was counted in 7 hours and 18 minutes.">
  <svg viewBox="0 0 360 140" role="img" aria-labelledby="f-night-t f-night-d">
    <title id="f-night-t">How fast the 2022 runoff was counted</title>
    <desc id="f-night-d">A horizontal time axis from 17:00, when polls closed, to 00:18 the next day. At 19:56 the winner was declared with 98.91 percent of machines counted. At 00:18 all 472,075 sections had been counted.</desc>
    <text x={x(0)} y="16" class="t-strong">17:00</text>
    <text x={x(176)} y="16" text-anchor="middle" class="t-strong t-accent">19:56</text>
    <text x={x(438)} y="16" text-anchor="end" class="t-strong">00:18</text>
    <rect x={x(0)} y="34" width={x(176) - x(0)} height="26" rx="3" class="box-accent" />
    <rect x={x(176)} y="34" width={x(438) - x(176)} height="26" rx="3" class="box-ground" />
    <path d={`M${x(176)} 26 V68`} class="wire-accent" />
    <text x={x(88)} y="52" text-anchor="middle" class="t-strong t-on-accent">2 h 56 min</text>
    <text x={x(0)} y="92" class="t-small t-muted">polls close</text>
    <text x={x(176)} y="92" text-anchor="middle" class="t-small t-muted">winner declared</text>
    <text x={x(176)} y="108" text-anchor="middle" class="t-small t-muted">98.91% counted</text>
    <text x={x(438)} y="92" text-anchor="end" class="t-small t-muted">all 472,075</text>
    <text x={x(438)} y="108" text-anchor="end" class="t-small t-muted">sections counted</text>
    <text x={x(0)} y="134" class="t-small t-muted">30–31 October 2022, Brasília time</text>
  </svg>
</Figure>
