---
import Arrow from './Arrow.astro'
import Figure from './Figure.astro'

const layers = [
  { title: 'Voting apps', note: 'VOTA, loader, verifiers' },
  { title: 'Libraries and drivers', note: 'signed in a public ceremony' },
  { title: 'Linux kernel (Uenux)', note: 'encrypted, signature checked' },
  { title: 'Bootloader', note: 'signature checked' },
  { title: 'BIOS', note: 'signature checked' },
  { title: 'Security chip', note: 'root of trust, in hardware', accent: true },
]
---

<Figure caption="The chain of trust. At power-on the security chip starts first and each layer checks the signature of the next. If any check fails, the machine locks and switches itself off.">
  <svg viewBox="0 0 420 400" role="img" aria-labelledby="f-boot-t f-boot-d">
    <title id="f-boot-t">The urna's software stack and chain of trust</title>
    <desc id="f-boot-d">Six stacked layers, read from the bottom up. At the bottom, the security chip, the hardware root of trust. Above it the BIOS, then the bootloader, then the Linux kernel called Uenux, which is encrypted, then libraries and drivers signed in a public ceremony, and at the top the voting applications. Arrows on the right point upward from each layer to the next, labelled "checks the signature of the next". If any check fails, the machine locks and switches off.</desc>
    <defs><Arrow id="f-boot-a" accent /></defs>
    {
      layers.map((l, i) => {
        const y = i * 62
        return (
          <g>
            <rect x="0" y={y} width="300" height="50" rx="6" class={l.accent ? 'box-accent' : 'box'} />
            <text x="16" y={y + 21} class={l.accent ? 't-strong t-on-accent' : 't-strong'}>{l.title}</text>
            <text x="16" y={y + 39} class={l.accent ? 't-small t-on-accent' : 't-small t-muted'}>{l.note}</text>
            {i > 0 && <path d={`M330 ${y + 50} V${y + 4}`} class="wire-accent" marker-end="url(#f-boot-a)" />}
          </g>
        )
      })
    }
    <text x="346" y="160" class="t-small t-accent">checks</text>
    <text x="346" y="176" class="t-small t-accent">the next</text>
    <text x="0" y="392" class="t-small t-muted">Any failed check: the urna locks and switches off.</text>
  </svg>
</Figure>
