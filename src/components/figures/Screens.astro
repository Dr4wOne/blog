---
// Real screenshots, side by side, inside an accessible figure. Images are optimized by astro:assets.

import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Figure from './Figure.astro'

interface Shot {
  src: ImageMetadata
  alt: string
}
interface Props {
  shots: Shot[]
  caption: string
  /** 'phone': portrait screens in a row; 'wide': one landscape screen across the column. */
  layout?: 'phone' | 'wide'
}
const { shots, caption, layout = 'phone' } = Astro.props
---

<Figure caption={caption}>
  <div class="shots" data-layout={layout}>
    {
      shots.map((s) => (
        <Image src={s.src} alt={s.alt} widths={layout === 'wide' ? [544, 1088] : [180, 360]} sizes={layout === 'wide' ? '(min-width: 36rem) 34rem, 100vw' : '(min-width: 36rem) 11rem, 30vw'} loading="lazy" decoding="async" />
      ))
    }
  </div>
</Figure>

<style>
  .shots {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    max-width: 34rem;
    margin-inline: auto;
  }
  .shots img {
    display: block;
    height: auto;
    border-radius: var(--radius, 6px);
    background: var(--surface);
    outline: 1px solid var(--surface-2);
  }
  .shots[data-layout='phone'] img {
    width: calc((100% - 1.5rem) / 3);
    max-width: 11rem;
  }
  .shots[data-layout='wide'] img {
    width: 100%;
  }
</style>
