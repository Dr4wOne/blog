---
import { CANDIDATES, PROMPT, probabilities } from '../../lib/temperature.ts'

const probs = probabilities(1)
const pct = (p: number) => `${(p * 100).toFixed(p < 0.1 ? 1 : 0)}%`
---

<section class="widget" data-widget="temperature" aria-labelledby="w-temp-title">
  <p class="widget-title" id="w-temp-title">Try it: temperature</p>
  <p class="widget-lede">
    Possible next words after “{PROMPT} …”, with the chance of each. Lower the temperature and the favourite
    takes over; raise it and unlikely words get a real chance. At 1.0 you see the model's own odds; at 0 it always picks the top word.
  </p>
  <div class="temp-control" data-js hidden>
    <label class="widget-label" for="w-temp-in">Temperature</label>
    <input id="w-temp-in" type="range" min="0" max="2" step="0.1" value="1" />
    <output for="w-temp-in" data-t>1.0</output>
  </div>
  <table class="temp-table">
    <caption class="visually-hidden">Next-word probabilities at temperature <span data-t>1.0</span></caption>
    <thead><tr><th scope="col">Word</th><th scope="col">Chance</th></tr></thead>
    <tbody>
      {
        CANDIDATES.map(([w], i) => (
          <tr>
            <th scope="row">{w}</th>
            <td>
              <span class="temp-bar" style={`--p:${(probs[i] as number) * 100}%`} />
              <span class="temp-pct">{pct(probs[i] as number)}</span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <div class="temp-sample" data-js hidden>
    <button type="button" class="widget-button" data-sample>Draw 10 words</button>
    <p class="widget-stats" aria-live="polite" data-samples>Each draw picks one word using the chances above.</p>
  </div>
  <p class="widget-note" data-nojs>Shown at temperature 1.0. Turn on JavaScript to move the slider.</p>
</section>
