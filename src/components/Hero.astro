---
interface Props {
  title: string;
  subtitle: string;
  readingTime: number;
}

const { title, subtitle, readingTime } = Astro.props;
---

<section class="hero">
  <!-- Subtle hero accent (faded game sprite) -->
  <div class="hero-accent">
    <img
      src="/assets/sprite-hero-dark.webp"
      alt=""
      role="presentation"
    />
  </div>

  <div class="hero-content">
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>

    <div class="meta">
      <span class="reading-time">📖 {readingTime} min read</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
  }

  .hero-accent {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    opacity: 0.05;
    pointer-events: none;
    filter: blur(20px);
  }

  .hero-accent img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .hero-content {
    max-width: var(--measure);
    position: relative;
    z-index: 1;
  }

  h1 {
    margin: 0 0 1.5rem;
    font-size: 3rem;
    line-height: 1.1;
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem;
    max-width: 55ch;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .reading-time {
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 0;
    }

    h1 {
      font-size: 1.75rem;
    }

    .subtitle {
      font-size: 1rem;
    }
  }
</style>
