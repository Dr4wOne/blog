---
import { LAYOUT, BREAKPOINTS } from '../constants/layout';

interface Props {
  title: string;
  subtitle: string;
  readingTime: number;
}

const { title, subtitle, readingTime } = Astro.props;
---

<section class="hero">
  <div class="hero-accent">
    <img
      src="/assets/sprite-hero-dark.webp"
      alt=""
      role="presentation"
    />
  </div>

  <div class="hero-content">
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>

    <div class="meta">
      <span class="reading-time">📖 {readingTime} min read</span>
    </div>
  </div>
</section>

<style define:vars={{
  heroAccentSize: '600px',
  heroAccentOpacity: '0.05',
  heroAccentBlur: '20px',
  h1FontSize: '3rem',
  h1LineHeight: '1.1',
  subtitleFontSize: '1.2rem',
  metaFontSize: '0.95rem',
  heroTopPadding: '4rem',
  heroBottomPadding: '3rem',
  heroMarginBottom: '3rem',
}}>
  .hero {
    padding: var(--heroTopPadding) 0 var(--heroBottomPadding);
    border-bottom: 1px solid rgba(255, 255, 255, var(--heroAccentOpacity));
    margin-bottom: var(--heroMarginBottom);
    position: relative;
    overflow: hidden;
  }

  .hero-accent {
    position: absolute;
    top: -20%;
    right: -10%;
    width: var(--heroAccentSize);
    height: var(--heroAccentSize);
    opacity: var(--heroAccentOpacity);
    pointer-events: none;
    filter: blur(var(--heroAccentBlur));
  }

  .hero-accent img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .hero-content {
    max-width: var(--measure);
    position: relative;
    z-index: 1;
  }

  h1 {
    margin: 0 0 1.5rem;
    font-size: var(--h1FontSize);
    line-height: var(--h1LineHeight);
  }

  .subtitle {
    font-size: var(--subtitleFontSize);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem;
    max-width: 55ch;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: var(--metaFontSize);
    color: var(--text-muted);
  }

  .reading-time {
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 0;
    }

    h1 {
      font-size: 1.75rem;
    }

    .subtitle {
      font-size: 1rem;
    }
  }
</style>
