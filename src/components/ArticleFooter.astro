---
/* Footer for article pages with links back to main site */
---

<footer class="article-footer">
  <div class="footer-divider"></div>

  <div class="footer-content">
    <div class="footer-section">
      <h3>Explore More</h3>
      <nav class="footer-links">
        <a href="https://dr4w.io" target="_blank" rel="noopener noreferrer">
          Daniel Baumann's Main Site
        </a>
        <a href="https://dr4w.io#about" target="_blank" rel="noopener noreferrer">
          About
        </a>
        <a href="https://dr4w.io#projects" target="_blank" rel="noopener noreferrer">
          Projects
        </a>
        <a href="https://dr4w.io#ai-agents" target="_blank" rel="noopener noreferrer">
          AI & Agents
        </a>
      </nav>
    </div>

    <div class="footer-section">
      <h3>Signal Log</h3>
      <nav class="footer-links">
        <a href="/">
          Blog Home
        </a>
        <a href="/archive">
          All Articles
        </a>
      </nav>
    </div>
  </div>

  <div class="footer-meta">
    <p>Signal Log — Technical essays on AI, systems, and engineering</p>
    <p><small>© 2026 Daniel Baumann</small></p>
  </div>
</footer>

<style>
  .article-footer {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    z-index: 2;
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(108, 99, 255, 0.2), transparent);
    margin-bottom: 3rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
    max-width: var(--measure);
  }

  .footer-section h3 {
    font-size: 1rem;
    color: var(--primary);
    margin: 0 0 1rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    border: none;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    padding: 0.25rem 0;
  }

  .footer-links a:hover {
    color: var(--accent);
    padding-left: 0.5rem;
  }

  .footer-meta {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.03);
  }

  .footer-meta p {
    margin: 0.5rem 0;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .article-footer {
      margin-top: 3rem;
      padding-top: 2rem;
    }
  }
</style>
