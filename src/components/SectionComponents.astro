---
import { SECTION_TYPES } from '../constants/labels';

export interface Props {
  type: 'core' | 'analogy' | 'memory' | 'file' | 'test' | 'next';
  title?: string;
  children?: any;
  href?: string;
}

const { type, title, href } = Astro.props;
---

{type === 'core' && (
  <div class="section-card core-idea">
    <div class="card-label">{SECTION_TYPES.core}</div>
    <div class="card-content">
      <slot />
    </div>
  </div>
)}

{type === 'analogy' && (
  <aside class="section-card field-analogy">
    <div class="card-label">{SECTION_TYPES.analogy}</div>
    <div class="card-content">
      <slot />
    </div>
  </aside>
)}

{type === 'memory' && (
  <div class="section-card key-insight">
    <div class="card-label">{SECTION_TYPES.memory}</div>
    <div class="card-content">
      <slot />
    </div>
  </div>
)}

{type === 'file' && (
  <details class="section-card recovered-file">
    <summary class="card-label">
      <span class="label-icon">→</span> {title}
    </summary>
    <div class="card-content">
      <slot />
    </div>
  </details>
)}

{type === 'test' && (
  <div class="section-card field-test">
    <div class="card-label">{SECTION_TYPES.test}</div>
    <div class="card-content">
      <slot />
    </div>
  </div>
)}


<style>
  .section-card {
    background: rgba(26, 26, 38, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.5rem;
    margin: 2rem 0;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .section-card:hover {
    border-color: rgba(108, 99, 255, 0.2);
    background: rgba(26, 26, 38, 0.8);
  }

  .card-label {
    font-family: var(--font-code);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--primary);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .card-content {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.6;
  }

  .card-content p {
    margin: 0.5rem 0;
  }

  .card-content ul,
  .card-content ol {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
  }

  .card-content li {
    margin: 0.25rem 0;
  }

  .card-content strong {
    color: var(--accent);
    font-weight: 600;
  }

  /* Specific card types */
  .core-idea {
    border-left: 3px solid var(--primary);
  }

  .field-analogy {
    border-left: 3px solid var(--accent);
  }

  .key-insight {
    border-left: 3px solid var(--warm);
  }

  .recovered-file {
    border-left: 3px solid var(--accent);
  }

  .recovered-file summary {
    cursor: pointer;
    user-select: none;
  }

  .recovered-file[open] {
    border-color: rgba(0, 217, 255, 0.2);
  }

  .label-icon {
    color: var(--accent);
  }

  .field-test {
    border-left: 3px solid var(--accent);
  }

  @media (max-width: 768px) {
    .section-card {
      padding: 1.25rem;
      margin: 1.5rem 0;
    }

    .card-label {
      font-size: 10px;
    }
  }
</style>
