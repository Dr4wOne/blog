---
import ArticleBody from '../../../../src/components/ArticleBody.astro'
import { SITE } from '../../components/data.ts'
import Page from '../../components/Page.astro'
import Toc from '../../components/Toc.astro'
import type { ArticleProps } from '../../components/types.ts'
import { fonts } from './fonts.ts'
import './theme.css'

const { post, toc, minutes, date, base } = Astro.props as ArticleProps
---

<Page title={`${post.data.title} · ${SITE.name}`} description={post.data.summary} fonts={fonts} theme="magazine" islands>
  <header class="site-header">
    <a class="wordmark" href={`${base}/`}>dr4w</a>
    <nav aria-label="Site"><a href={`${base}/#issues`}>Issues</a><a href={SITE.home}>About</a></nav>
  </header>
  <main id="main">
    <article>
      <header class="opener">
        <p class="opener-num" aria-hidden="true">{post.issue}</p>
        <div class="opener-text">
          <h1>{post.data.title}</h1>
          <p class="kicker">Issue {post.issue} · <time datetime={post.published.toISOString().slice(0, 10)}>{date}</time></p>
          <p class="dek">{post.data.summary}</p>
          <p class="byline">By <a href={SITE.home}>{SITE.author}</a> · {minutes} minute read</p>
        </div>
      </header>
      <div class="column">
        <Toc headings={toc} label="In this issue" />
        <div class="prose"><ArticleBody post={post} /></div>
      </div>
    </article>
  </main>
  <footer class="site-footer"><p>{SITE.author} · <a href={SITE.home}>dr4w.io</a> · <a href={`${base}/`}>All issues</a></p></footer>
</Page>
