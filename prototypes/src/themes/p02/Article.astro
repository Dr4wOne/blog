---
import ArticleBody from '../../../../src/components/ArticleBody.astro'
import { SITE } from '../../components/data.ts'
import Page from '../../components/Page.astro'
import Toc from '../../components/Toc.astro'
import type { ArticleProps } from '../../components/types.ts'
import { fonts } from './fonts.ts'
import './theme.css'

const { post, toc, minutes, date, base } = Astro.props as ArticleProps
---

<Page title={`${post.data.title} · ${SITE.name}`} description={post.data.summary} fonts={fonts} theme="swiss" islands>
  <header class="site-header grid">
    <a class="wordmark" href={`${base}/`}>dr4w</a>
    <p class="site-desc">Writing by {SITE.author}</p>
    <nav aria-label="Site"><a href={`${base}/#issues`}>Issues</a><a href={SITE.home}>dr4w.io</a></nav>
  </header>
  <main id="main">
    <article>
      <header class="opener grid">
        <h1>{post.data.title}</h1>
        <p class="meta">Issue {post.issue}<br /><time datetime={post.published.toISOString().slice(0, 10)}>{date}</time><br />{minutes} min read</p>
        <p class="dek">{post.data.summary}</p>
      </header>
      <div class="body grid">
        <div class="rail"><Toc headings={toc} label="Contents" /></div>
        <div class="prose"><ArticleBody post={post} /></div>
      </div>
    </article>
  </main>
  <footer class="site-footer grid"><p class="big">dr4w</p><p>{SITE.author} · <a href={SITE.home}>dr4w.io</a> · <a href={`${base}/`}>All issues</a></p></footer>
</Page>
