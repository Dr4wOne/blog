---
import { SITE } from '../../components/data.ts'
import Page from '../../components/Page.astro'
import type { HomeProps } from '../../components/types.ts'
import { fonts } from './fonts.ts'
import './theme.css'

const { issues, base } = Astro.props as HomeProps
---

<Page title={`${SITE.name}: writing by ${SITE.author}`} description={SITE.tagline} fonts={fonts} theme="paper">
  <header class="site-header"><a class="wordmark" href={`${base}/`}>dr4w</a><nav aria-label="Site"><a href="#issues">Issues</a><a href={SITE.home}>Author</a></nav></header>
  <main id="main" class="col">
    <h1 class="home-title">Working papers on AI</h1>
    <p class="home-sub">Explanations with figures and sources, by <a href={SITE.home}>{SITE.author}</a>. Every technical claim cites a primary source.</p>
    <section id="issues" aria-labelledby="issues-h">
      <h2 id="issues-h" class="ui-label">Issues</h2>
      {
        issues.map((i) => (
          <article class="entry">
            <h3>
              <a href={`${base}${i.post.path}`}>{i.post.data.title}</a>
            </h3>
            <p class="ui-meta">Issue {i.post.issue} · {i.date} · {i.toc.length} sections · {i.minutes} min</p>
            <p>{i.post.data.summary}</p>
          </article>
        ))
      }
    </section>
  </main>
  <footer class="site-footer col"><p class="ui-meta">{SITE.author} · <a href={SITE.home}>dr4w.io</a></p></footer>
</Page>
