---
import ArticleBody from '../../../../src/components/ArticleBody.astro'
import { SITE } from '../../components/data.ts'
import Page from '../../components/Page.astro'
import Toc from '../../components/Toc.astro'
import type { ArticleProps } from '../../components/types.ts'
import { fonts } from './fonts.ts'
import './theme.css'

const { post, toc, minutes, date, base } = Astro.props as ArticleProps
---

<Page title={`${post.data.title} · ${SITE.name}`} description={post.data.summary} fonts={fonts} theme="paper" islands>
  <header class="site-header"><a class="wordmark" href={`${base}/`}>dr4w</a><nav aria-label="Site"><a href={`${base}/#issues`}>Issues</a><a href={SITE.home}>Author</a></nav></header>
  <main id="main" class="paper">
    <article class="col">
      <header class="front">
        <h1>{post.data.title}</h1>
        <p class="authors"><a href={SITE.home}>{SITE.author}</a></p>
        <p class="ui-meta">Issue {post.issue} · <time datetime={post.published.toISOString().slice(0, 10)}>{date}</time> · {minutes} min read</p>
        <div class="abstract"><p><strong>Abstract.</strong> {post.data.summary} Eight sections build one mental model: from tokens and embeddings through transformers and inference, to agents, harnesses and the configuration teams use.</p></div>
        <p class="ui-meta keywords">Keywords: {post.data.tags.join(', ')}</p>
      </header>
      <Toc headings={toc} label="Contents" />
      <div class="prose"><ArticleBody post={post} /></div>
    </article>
  </main>
  <footer class="site-footer col"><p class="ui-meta">{SITE.author} · <a href={SITE.home}>dr4w.io</a> · <a href={`${base}/`}>All issues</a></p></footer>
</Page>
