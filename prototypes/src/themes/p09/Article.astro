---
import ArticleBody from '../../../../src/components/ArticleBody.astro'
import { SITE } from '../../components/data.ts'
import Page from '../../components/Page.astro'
import Toc from '../../components/Toc.astro'
import type { ArticleProps } from '../../components/types.ts'
import { fonts } from './fonts.ts'
import './theme.css'

const { post, toc, minutes, date, base } = Astro.props as ArticleProps
---

<Page title={`${post.data.title} · ${SITE.name}`} description={post.data.summary} fonts={fonts} theme="dark" islands>
  <header class="site-header wide"><a class="wordmark" href={SITE.home}>dr4w<span>.</span>io</a><nav aria-label="Site"><a href={`${base}/`}>Writing</a><a href={SITE.home}>About</a></nav></header>
  <main id="main" class="wide art">
    <article class="main">
      <header class="opener">
        <h1>{post.data.title}</h1>
        <p class="l-meta">Issue {post.issue} · <time datetime={post.published.toISOString().slice(0, 10)}>{date}</time> · {minutes} min read</p>
        <p class="dek">{post.data.summary}</p>
        <p class="byline">{SITE.author}</p>
      </header>
      <div class="prose"><ArticleBody post={post} /></div>
    </article>
    <aside class="rail" aria-label="Contents"><Toc headings={toc} label="On this page" /></aside>
  </main>
  <footer class="site-footer wide"><p class="big">dr4w<span>.</span>io</p><p>{SITE.author} · <a href={`${base}/`}>All issues</a> · <a href={SITE.home}>Main site</a></p></footer>
</Page>
