---
import ArticleBody from '../../../../src/components/ArticleBody.astro'
import { SITE } from '../../components/data.ts'
import Page from '../../components/Page.astro'
import type { ArticleProps } from '../../components/types.ts'
import { fonts } from './fonts.ts'
import './theme.css'

const { post, minutes, date, base } = Astro.props as ArticleProps
---

<Page title={`${post.data.title} · ${SITE.name}`} description={post.data.summary} fonts={fonts} theme="index" islands>
  <header class="site-header quiet"><a class="wordmark" href={`${base}/`}>dr4w</a><a href={`${base}/`}>Index</a></header>
  <main id="main" class="quiet">
    <article>
      <h1>{post.data.title}</h1>
      <p class="art-meta">Issue {post.issue} · {SITE.author} · <time datetime={post.published.toISOString().slice(0, 10)}>{date}</time> · {minutes} min</p>
      <p class="art-sum">{post.data.summary}</p>
      <div class="prose"><ArticleBody post={post} /></div>
    </article>
  </main>
  <footer class="site-footer quiet"><p><a href={`${base}/`}>Back to the index</a> · <a href={SITE.home}>dr4w.io</a></p></footer>
</Page>
